---
import PostHog from '../components/posthog.astro';
import PostHogEvents from '../components/posthog-events.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "A private iPhone app for the days before your period. Reflect on a hard moment, regulate in about a minute, respond with a clearer head. No account, and your personal details are stripped before anything is sent.",
  ogImage = '/hero-shot.png',
  ogType = "website",
  canonicalUrl = Astro.url.href,
  jsonLd,
} = Astro.props;

const ogImageAbsolute = new URL(ogImage, Astro.site).href;

// Every page is also served as markdown for AI crawlers (/faq/ -> /faq.md),
// written by scripts/md-twins.mjs after the build. Same exclusions as there.
const path = Astro.url.pathname;
const mdUrl = /^\/(lab|demo)\/|^\/404/.test(path)
  ? null
  : new URL(path === '/' ? '/index.md' : `${path.replace(/\/$/, '')}.md`, Astro.site).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Niyora" href="https://niyora.com/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <link rel="canonical" href={canonicalUrl} />
    {mdUrl && <link rel="alternate" type="text/markdown" href={mdUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    {jsonLdBlocks.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <PostHog />
    <PostHogEvents />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Poppins';
    font-style: normal;
    font-weight: 300;
    font-display: swap;
    src: url('/fonts/poppins-latin-300.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Poppins';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/poppins-latin-400.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Poppins';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/poppins-latin-500.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Poppins';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/poppins-latin-600.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --orb-hue: 30;
    --orb-sat: 70%;
    --orb-light: 60%;

    /* Frosted glass, matched to the app's Moon surfaces
       (BlurView 72 + violet tint rgba(34,27,54,0.66)). One source of truth
       so every card on the site reads as the same material. */
    --glass-bg: rgba(34, 27, 54, 0.55);
    --glass-bg-soft: rgba(34, 27, 54, 0.4);
    --glass-border: rgba(255, 255, 255, 0.12);
    --glass-blur: blur(20px) saturate(1.3);
    --glass-shadow: 0 10px 34px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Poppins', sans-serif;
    background: #050409;
    background-image: linear-gradient(180deg, #0e0b14 0%, #050409 55%, #000000 100%);
    background-attachment: fixed;
    color: rgba(255, 255, 255, 0.92);
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.6;
  }
  a { color: inherit; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
