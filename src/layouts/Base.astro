---
import PostHog from '../components/posthog.astro';
import PostHogEvents from '../components/posthog-events.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "A private iPhone app for the week before your period. Niyora learns when your PMS week is coming, helps you steady in about a minute, and explains why you feel this way. Nothing leaves your phone.",
  ogImage = '/hero-shot.png',
  ogType = "website",
  canonicalUrl = Astro.url.href,
} = Astro.props;

const ogImageAbsolute = new URL(ogImage, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <PostHog />
    <PostHogEvents />
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --orb-hue: 30;
    --orb-sat: 70%;
    --orb-light: 60%;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Poppins', sans-serif;
    background: #07060f;
    color: rgba(255, 255, 255, 0.92);
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.6;
  }
  a { color: inherit; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
