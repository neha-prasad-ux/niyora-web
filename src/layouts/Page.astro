---
// Content-page layout: the shared "neat" chrome. Wraps Base (head/SEO,
// SiteHeader, PostHog), paints the fixed Sky and Moon behind a single frosted
// glass sheet, and renders <SiteFooter /> at the end. Any page that wants the
// homepage's look renders its sections inside <Page ...props>.
//
// Design tokens for the whole neat system live in the :root block below (one
// place to change background, text scale colours, glass, hairline, accent, and
// the moon/glow palette). The shared structural CSS (type scale, .s section +
// hairline, .btn) is is:global so it reaches section markup authored in the
// child page.
import Base from './Base.astro';
import Sky from '../components/Sky.astro';
import Moon from '../components/Moon.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, ogType, canonicalUrl, jsonLd } = Astro.props;
---

<Base
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <slot name="head" slot="head" />

  <Sky />
  <Moon />

  <main class="neat">
    <div class="sheet">
      <slot />
    </div>
  </main>

  <SiteFooter />
</Base>

<style is:global>
  /* ── Neat design tokens: one source of truth for every Page ──
     Change a value here and it changes across all pages that use Page. */
  :root {
    /* Background / surfaces */
    --sky-bg: #0a0814;                       /* deep sky behind the glass */
    --sheet-bg: rgba(18, 14, 30, 0.55);      /* frosted glass fill */
    --sheet-border: rgba(255, 255, 255, 0.12);
    --sheet-blur: blur(28px) saturate(1.3);
    --hairline: rgba(255, 255, 255, 0.08);   /* divider between sections */

    /* Brand accent (pink). Triplet so callers can set their own alpha. */
    --accent-rgb: 244, 178, 203;

    /* Text scale colours */
    --text-1: rgba(255, 255, 255, 0.96);     /* h1 */
    --text-2: rgba(255, 255, 255, 0.94);     /* h2 */
    --text-3: rgba(255, 255, 255, 0.92);     /* h3 */
    --text-body: rgba(255, 255, 255, 0.62);  /* p */
    --text-lead: rgba(255, 255, 255, 0.74);  /* .lead / .afterword */

    /* Button fill (the dark inner layer under the gradient border) */
    --btn-fill: rgba(18, 13, 26, 0.92);

    /* Moon layer palette, consumed by Moon.astro. */
    --moon-glow: radial-gradient(circle,
      rgba(255, 168, 108, 0.55) 0%,
      rgba(246, 148, 190, 0.40) 32%,
      rgba(168, 104, 214, 0.22) 54%,
      rgba(168, 104, 214, 0.08) 72%,
      rgba(168, 104, 214, 0) 88%);
    --moon-face: radial-gradient(circle at 42% 38%, #f7f5fb 0%, #eceaf3 52%, #dddbe8 100%);
  }

  .neat {
    position: relative;
    z-index: 2;
    padding: 16px 16px 20px;
  }

  /* ── ONE glass surface holding everything ──
     A single centered rounded panel with backdrop-blur, a hairline border and
     a soft shadow. Not one card per section. */
  .sheet {
    max-width: 1600px;
    margin: 0 auto;
    border-radius: 28px;
    /* Translucent enough that the fixed moon behind reads as a soft glow, dark
       enough (plus text-shadow below) that copy over the brightest disc stays
       legible. Heavy blur turns the disc into diffuse light, not a hotspot. */
    background: var(--sheet-bg);
    border: 1px solid var(--sheet-border);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: var(--sheet-blur);
    -webkit-backdrop-filter: var(--sheet-blur);
    overflow: hidden;
  }

  /* ── Sections divided by hairline rules ──
     Consistent centered rhythm, generous vertical padding, a thin rule between
     each section. No per-section floating cards. */
  .s {
    text-align: center;
    padding: 76px 56px;
    border-top: 1px solid var(--hairline);
  }
  .s:first-child { border-top: none; }

  /* ── Consistent type scale ── */
  h1 {
    font-size: 46px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: var(--text-1);
    max-width: 640px;
    margin: 0 auto 20px;
  }
  h2 {
    font-size: 30px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.3px;
    color: var(--text-2);
    max-width: 640px;
    margin: 0 auto 16px;
  }
  h3 {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-3);
    margin-bottom: 10px;
  }
  p { font-size: 16px; font-weight: 300; color: var(--text-body); }

  /* Text scrim: a soft dark halo per glyph keeps copy readable where the moon
     glows brightest behind the frost, without adding opaque panels that would
     break the single-glass look. */
  .s h1, .s h2, .s h3, .s p, .s .eyebrow, .s .card-eyebrow {
    text-shadow: 0 1px 18px rgba(6, 4, 14, 0.55);
  }

  /* Left-aligned sections on a wider measure, for layout rhythm.
     Dividers and the shared type scale stay; only the arrangement changes. */
  .s.left { text-align: left; }
  .s.left h1,
  .s.left h2,
  .s.left .lead,
  .s.left .afterword,
  .s.left .subhead { margin-left: 0; margin-right: 0; max-width: 720px; }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(var(--accent-rgb), 0.75);
    margin-bottom: 16px;
  }
  .lead {
    font-size: 19px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-lead);
    max-width: 620px;
    margin: 0 auto 36px;
  }
  .afterword {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    max-width: 620px;
    margin: 36px auto 0;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-block;
    cursor: pointer;
    padding: 15px 34px;
    border-radius: 30px;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.3px;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.95);
    border: 1.5px solid transparent;
    background-image:
      linear-gradient(var(--btn-fill), var(--btn-fill)),
      linear-gradient(95deg, #e6a3c4, #9c5c86, #7846b0);
    background-origin: border-box;
    background-clip: padding-box, border-box;
    box-shadow: 0 0 30px rgba(244, 178, 203, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 44px rgba(244, 178, 203, 0.42);
  }
  .btn.is-done {
    color: rgba(255, 255, 255, 0.7);
    box-shadow: none;
    cursor: default;
    transform: none;
  }
  .btn.store {
    background-image: none;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }
  .btn.store:hover { border-color: rgba(255, 255, 255, 0.55); }
  .btn.ghost {
    background-image: none;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: none;
    color: rgba(255, 255, 255, 0.85);
  }
  .btn.ghost:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.45); }
</style>
