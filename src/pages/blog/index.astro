---
import Page from '../../layouts/Page.astro';
import { getCollection } from 'astro:content';
import { breadcrumbs } from '../../components/_breadcrumbs';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const crumbs = breadcrumbs([{ name: 'Writing', href: '/blog/' }]);
---

<Page
  title="Writing · Niyora"
  description="Notes on stress, women's health, and building Niyora in the open. Evidence-led, quietly written."
  canonicalUrl="https://niyora.com/blog/"
  jsonLd={crumbs}
>
  <section class="s">
    <div class="wrap">
      <h1>Writing</h1>
      <p class="lede">Notes on stress, women's health, and building in the open. Evidence-led, no hype.</p>

      <ul class="posts">
        {posts.map((post) => (
          <li class="post">
            <a href={`/blog/${post.id}/`}>
              <div class="meta">
                <span class="cat">{post.data.category}</span>
                <span class="date">{fmt(post.data.date)}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p class="desc">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>

      {posts.length === 0 && <p class="empty">Nothing published yet. Soon.</p>}
    </div>
  </section>
</Page>

<style>
  .wrap {
    max-width: 680px;
    margin: 0 auto;
    text-align: left;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
  }

  h1 {
    font-size: 32px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    max-width: none;
    margin: 0 0 8px;
    letter-spacing: -0.3px;
  }
  .lede {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 48px;
  }

  .posts { list-style: none; padding: 0; margin: 0; }
  .post {
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
  }
  .post:first-child { border-top: none; padding-top: 0; }
  .post a { text-decoration: none; display: block; }
  .meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }
  .cat {
    font-size: 11px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: hsla(335, 60%, 78%, 0.9);
  }
  .date {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.4px;
  }
  .post h2 {
    font-size: 20px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    max-width: none;
    margin: 0 0 8px;
    letter-spacing: -0.2px;
    line-height: 1.3;
  }
  .post a:hover h2 { color: #fff; }
  .desc {
    font-size: 14px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
  .empty {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 760px) {
    h1 { font-size: 28px; }
  }
</style>
