---
import Page from '../../layouts/Page.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = await getCollection('blog', ({ data }) => !data.draft);
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .filter((x) => x.shared > 0)
  .sort((a, b) => b.shared - a.shared || +b.p.data.date - +a.p.data.date)
  .slice(0, 3)
  .map((x) => x.p);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const canonical = post.data.canonical ?? `https://niyora.com/blog/${post.id}/`;
const publisher = {
  '@type': 'Organization',
  name: 'Niyora',
  url: 'https://niyora.com',
  logo: 'https://niyora.com/icon.png',
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    mainEntityOfPage: canonical,
    author: publisher,
    publisher,
    ...(post.data.ogImage ? { image: post.data.ogImage } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://niyora.com' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://niyora.com/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  },
];
---

<Page
  title={`${post.data.title} · Niyora`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.ogImage}
  canonicalUrl={canonical}
  jsonLd={jsonLd}
>
  <section class="s left">
    <article class="wrap">
      <div class="eyebrow"><a href="/blog/">Writing</a></div>
      <div class="meta">
        {post.data.category !== 'Blog' && <span class="cat">{post.data.category}</span>}
        <span class="date">{fmt(post.data.date)}</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>

      <div class="prose">
        <Content />
      </div>

      {related.length > 0 && (
        <aside class="related">
          <h2>Keep reading</h2>
          <ul>
            {related.map((p) => (
              <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
            ))}
          </ul>
        </aside>
      )}

      <p class="foot">
        Not sure how much PMS is affecting you? <a href="/quiz/">Take the 2-minute check</a>, or <a href="/guide/">read the short guide</a>. Niyora is a quiet minute of breathing whenever the day tightens. <a href="/">See the app</a>.
      </p>
    </article>
  </section>
</Page>

<style>
  /* Page-specific only: the article measure and the markdown prose. The column
     follows the same shape as /about/ (.s.left plus a centered measure), so the
     type scale, hairlines and accent all come from Page. */
  .wrap { max-width: 680px; margin: 0 auto; line-height: 1.7; color: rgba(255, 255, 255, 0.7); }

  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { color: rgba(255, 255, 255, 0.95); }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .cat {
    font-size: 11px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: rgba(var(--accent-rgb), 0.9);
  }
  .date {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.35);
    letter-spacing: 0.4px;
  }

  .wrap .lead { padding-bottom: 32px; border-bottom: 1px solid var(--hairline); }

  .prose { font-size: 16px; font-weight: 300; color: rgba(255, 255, 255, 0.78); }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(h2) {
    font-size: 21px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    max-width: none;
    margin: 44px 0 16px;
    letter-spacing: -0.2px;
  }
  .prose :global(h3) {
    font-size: 17px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    margin: 32px 0 12px;
  }
  .prose :global(strong) { color: rgba(255, 255, 255, 0.95); font-weight: 500; }
  .prose :global(a) {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.5);
  }
  .prose :global(a:hover) { border-bottom-color: rgba(var(--accent-rgb), 0.95); }
  .prose :global(ul) { margin: 0 0 22px; padding-left: 20px; }
  .prose :global(li) { margin: 0 0 10px; }
  .prose :global(blockquote) {
    margin: 0 0 22px;
    padding-left: 18px;
    border-left: 2px solid rgba(var(--accent-rgb), 0.4);
    color: rgba(255, 255, 255, 0.66);
  }

  .related {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
  }
  .related h2 {
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    max-width: none;
    margin: 0 0 16px;
    font-weight: 500;
  }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .related li { margin: 0; }
  .related a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 16px;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.35);
  }
  .related a:hover { color: #fff; border-bottom-color: rgba(var(--accent-rgb), 0.9); }

  .foot {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
  }
  .foot a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }
  .foot a:hover { color: #fff; border-bottom-color: rgba(255, 255, 255, 0.6); }

  @media (max-width: 720px) {
    .s { padding: 56px 24px; }
    h1 { font-size: 34px; }
  }
</style>
