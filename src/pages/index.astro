---
import Base from '../layouts/Base.astro';
import OrbStage from '../components/OrbStage.astro';
---

<Base title="Niyora · Calm in 60 seconds">
  <OrbStage />

  <main class="content">
    <section class="hero" data-hue="220" data-sat="60%" data-orb-alpha="0.2" data-orb-scale="0.55">
      <div class="hero-grid">
        <div class="hero-text">
          <div class="brand">Niyora</div>
          <h1>Calm in 60 seconds.</h1>
          <p class="subhead">Breathing and mindfulness, right at your desk.<br />From your menu bar or system tray.</p>
          <div class="cta-row">
            <a id="primary-download" href="https://downloads.niyora.com/Niyora-0.4.0-AppleSilicon.dmg" class="cta" data-arch="apple-silicon">
              Download for Mac
            </a>
          </div>
          <div class="trust">
            <div class="trust-row">Free to use · No account · No wearables · No health data</div>
            <div class="trust-strong">Nothing leaves your Mac.</div>
          </div>
        </div>
        <div class="hero-image-wrap">
          <img src="/hero-shot.png" alt="Niyora panel showing Box Breath, with Begin button" class="hero-shot" loading="eager" />
        </div>
      </div>
    </section>

    <section class="features" data-hue="225" data-sat="55%">
      <div class="feature-grid">
        <div class="feature-card">
          <h3>Notices when you're tensing up</h3>
          <p>Niyora watches your work patterns and nudges you when stress is building.</p>
        </div>
        <div class="feature-card">
          <h3>60-second guided practices</h3>
          <p>Breathing, mindfulness, and grounding moments. Pick one or let Niyora choose.</p>
        </div>
        <div class="feature-card">
          <h3>Unlocked as you go</h3>
          <p>Niyora grows with you. New practices unlock as you keep showing up.</p>
        </div>
      </div>
    </section>

    <section class="launch-video" data-hue="235" data-sat="60%">
      <div class="eyebrow">See it in motion</div>
      <h2>Sixty seconds of calm, in your menu bar.</h2>
      <div class="video-frame">
        <video
          controls
          preload="none"
          playsinline
          poster="https://assets.niyora.com/niyora-launch-poster.jpg"
          src="https://assets.niyora.com/niyora-launch.mp4"
        ></video>
      </div>
    </section>

    <section id="problem" data-hue="245" data-sat="55%">
      <div class="eyebrow">The problem</div>
      <h2>The work that runs the world is wearing us down.</h2>
      <p class="lead">Sitting at a screen for hours isn't free. The research is clear: prolonged computer work raises stress, fragments attention, and quietly compounds.</p>
      <div class="research-grid">
        <div class="research-card">
          <h3>Working without breaks builds stress in your brain.</h3>
          <p>An EEG study showed beta-wave stress activity climbs through back-to-back meetings, and only resets when you pause.</p>
          <div class="cite">Microsoft Human Factors Lab, 2021</div>
        </div>
        <div class="research-card">
          <h3>Your attention span at a screen has collapsed to 47 seconds.</h3>
          <p>In 2004 it was 2.5 minutes. Two decades of screens later, focus shrinks every year.</p>
          <div class="cite">Gloria Mark, UC Irvine</div>
        </div>
        <div class="research-card">
          <h3>Less screen time, better mood.</h3>
          <p>When adults reduced their daily digital screen use, well-being and mood improved within two weeks.</p>
          <div class="cite">Nature npj Mental Health Research, 2022</div>
        </div>
      </div>
    </section>

    <section id="solution" data-hue="260" data-sat="55%">
      <div class="eyebrow">The solution</div>
      <h2>Recognise stress. Bring calm. Make a habit.</h2>
      <div class="solution-grid">
        <div class="solution-card">
          <div class="orb-mini orb-pulse"></div>
          <div class="card-eyebrow">Recognise stress</div>
          <h3>It watches the rhythm of your work.</h3>
          <p>Niyora reads passive signals from your Mac. How long you've been at the screen, what time of day, whether you're switching contexts. No wearables, no biometrics. Just the rhythm of your day.</p>
        </div>
        <div class="solution-card">
          <div class="orb-mini orb-breathe"></div>
          <div class="card-eyebrow">Bring calm</div>
          <h3>Sixty seconds, when you need them.</h3>
          <p>When stress is building, Niyora nudges you with a soft notification. One click opens a guided practice. Breathing, mindfulness, grounding. Fourteen techniques rooted in pranayama, CBT, and self-compassion.</p>
        </div>
        <div class="solution-card">
          <div class="orb-mini orb-rings">
            <span class="ring r1"></span>
            <span class="ring r2"></span>
            <span class="ring r3"></span>
          </div>
          <div class="card-eyebrow">Make a habit</div>
          <h3>Your soul, growing with you.</h3>
          <p>Each session lights up your soul. New practices unlock as you keep showing up. No streaks to break, no guilt. Just a quiet sense of arrival, one minute at a time.</p>
        </div>
      </div>
    </section>

    <section data-hue="230" data-sat="65%">
      <div class="eyebrow">Research backed</div>
      <h2>Every practice has a paper behind it.</h2>
      <p class="lead">No mystic claims. Just techniques validated in peer-reviewed research, clearly cited so you can read the source.</p>
      <div class="papers">
        <div class="paper">
          <div class="title">Box Breathing</div>
          <div class="cite">Used in Navy SEAL training. Lowers cortisol, improves HRV.</div>
        </div>
        <div class="paper">
          <div class="title">4-7-8 Breath</div>
          <div class="cite">Activates parasympathetic nervous system. Weil, A. Spontaneous Healing.</div>
        </div>
        <div class="paper">
          <div class="title">Diaphragmatic Breathing</div>
          <div class="cite">Ma et al, 2017. Reduces stress and negative affect.</div>
        </div>
        <div class="paper">
          <div class="title">PSS-4 Check-in</div>
          <div class="cite">Cohen, 1983. Validated 4-item perceived stress scale.</div>
        </div>
        <div class="paper">
          <div class="title">Trataka (Soft Gaze)</div>
          <div class="cite">Improves attention and selective focus. Talwadkar et al, 2014.</div>
        </div>
        <div class="paper">
          <div class="title">Self-Compassion</div>
          <div class="cite">Neff, 2003. Linked to reduced anxiety and rumination.</div>
        </div>
        <div class="paper">
          <div class="title">Alternate Nostril (Naadishodhana)</div>
          <div class="cite">Sharma et al, 2013. Lowers blood pressure, improves cardiovascular function.</div>
        </div>
        <div class="paper">
          <div class="title">Ocean Breath (Ujjayi)</div>
          <div class="cite">Pal et al, 2011. Activates vagus nerve, slows heart rate.</div>
        </div>
        <div class="paper">
          <div class="title">5-4-3-2-1 Grounding</div>
          <div class="cite">Linehan, 1993 (DBT). Reduces panic and dissociation.</div>
        </div>
        <div class="paper">
          <div class="title">Loving Kindness Meditation</div>
          <div class="cite">Fredrickson, 2008. Builds positive affect and social connection.</div>
        </div>
        <div class="paper">
          <div class="title">Cooling Breath (Sheetali)</div>
          <div class="cite">Pranayama tradition. Lowers body heat, reduces sympathetic arousal.</div>
        </div>
        <div class="paper">
          <div class="title">Affirmations / Kind Words</div>
          <div class="cite">Cascio et al, 2016. Reduces stress reactivity in fMRI studies.</div>
        </div>
      </div>
      <p class="more-line">and more, every practice rooted in research.</p>
    </section>

    <section data-hue="210" data-sat="60%">
      <div class="eyebrow">Privacy, locally</div>
      <h2>Nothing leaves your Mac. Ever.</h2>
      <p class="lead">Most wellness apps want your account, your data, and a server log of your worst days. Niyora wants none of it.</p>
      <div class="privacy-points">
        <div class="privacy-point">
          <div class="check">✓</div>
          <h3>No accounts</h3>
          <p>Open the app. Start breathing. That is the entire onboarding.</p>
        </div>
        <div class="privacy-point">
          <div class="check">✓</div>
          <h3>No telemetry</h3>
          <p>The app makes zero outbound network requests of its own. Verifiable in source.</p>
        </div>
        <div class="privacy-point">
          <div class="check">✓</div>
          <h3>Local storage</h3>
          <p>Sessions and check-ins live in your app container. Never read off-device.</p>
        </div>
      </div>
    </section>

    <section class="founder" data-hue="335" data-sat="60%">
      <div class="eyebrow">From the founder</div>
      <img src="/neha.jpg" alt="Neha Prasad" class="founder-photo" loading="lazy" />
      <p class="quote">I wanted calm on my own terms.</p>
      <p class="quote-body">As a doctor in the Indian system of medicine, I knew it isn't much to ask. A minute to breathe. A way to feel less overwhelmed. To be excited before something that matters. To feel at home, even in chaos.</p>
      <p class="quote-body">I built Niyora for myself first. Now I'm sharing it with you. If it lands well, or doesn't, I'd love to know. My inbox is open.</p>
      <div class="signature">Neha Prasad. Doctor, builder, founder of Niyora.</div>
      <div class="founder-cta">
        <a href="/talk" class="cta ghost">Say hello</a>
      </div>
    </section>

    <section id="downloads" class="downloads" data-hue="30" data-sat="70%">
      <div class="eyebrow">Downloads</div>
      <h2>Pick the build for your machine.</h2>
      <p class="lead">Mac builds are signed by Apple Developer ID and notarized. Windows is unsigned for v1; the installer triggers a SmartScreen warning the first time.</p>
      <div class="download-grid">
        <a href="https://downloads.niyora.com/Niyora-0.4.0-AppleSilicon.dmg" class="download-card" data-arch="apple-silicon">
          <div class="dl-arch">Apple Silicon</div>
          <div class="dl-detail">M1, M2, M3, M4. macOS 11 Big Sur or later.</div>
          <div class="dl-meta">v0.4.0 · 32 MB · arm64</div>
        </a>
        <a href="https://downloads.niyora.com/Niyora-0.4.0-Intel.dmg" class="download-card" data-arch="intel">
          <div class="dl-arch">Intel</div>
          <div class="dl-detail">Pre-2020 MacBook, iMac, Mac mini. macOS 10.15 Catalina or later.</div>
          <div class="dl-meta">v0.4.0 · 33 MB · x86_64</div>
        </a>
        <a href="https://downloads.niyora.com/Niyora-0.4.0-Windows-x64.exe" class="download-card" data-arch="windows-x64">
          <div class="dl-arch">Windows</div>
          <div class="dl-detail">Windows 10 or 11. 64-bit. First launch: click "More info", then "Run anyway".</div>
          <div class="dl-meta">v0.4.0 · 29 MB · x86_64</div>
        </a>
      </div>
      <p class="meta unsure">On a Mac and unsure which? Apple menu, About This Mac. If it says "Apple M…" you want Apple Silicon. Otherwise Intel.</p>
    </section>

    <section class="final-cta" data-hue="30" data-sat="70%">
      <h2>Take the next breath.</h2>
      <p class="lead">It takes a minute to install. Sixty seconds to feel different.</p>
      <div class="cta-row">
        <a id="final-download" href="https://downloads.niyora.com/Niyora-0.4.0-AppleSilicon.dmg" class="cta" data-arch="apple-silicon">Download for Mac</a>
      </div>
      <div class="meta">Mac (Apple Silicon, Intel) and Windows 10 or 11.</div>
    </section>
  </main>

  <script>
    // Route the primary and final CTAs to the right installer for the visitor.
    // Default in the source: Apple Silicon. JS overrides to Intel (Mac with Intel
    // GPU detected via WebGL renderer) or to Windows (Windows user agent).
    (function () {
      const apple = 'https://downloads.niyora.com/Niyora-0.4.0-AppleSilicon.dmg';
      const intel = 'https://downloads.niyora.com/Niyora-0.4.0-Intel.dmg';
      const windows = 'https://downloads.niyora.com/Niyora-0.4.0-Windows-x64.exe';

      function applyCta(url, arch, label) {
        ['primary-download', 'final-download'].forEach(function (id) {
          const a = document.getElementById(id);
          if (!a) return;
          a.href = url;
          a.dataset.arch = arch;
          if (label) a.textContent = label;
        });
      }

      const isWindows = /Windows/i.test(navigator.userAgent);
      if (isWindows) {
        applyCta(windows, 'windows-x64', 'Download for Windows');
        return;
      }

      const isMac = /Mac|iPhone|iPad/i.test(navigator.userAgent);
      if (!isMac) return;

      function detectMacArch() {
        try {
          const canvas = document.createElement('canvas');
          const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
          if (!gl) return null;
          const ext = gl.getExtension('WEBGL_debug_renderer_info');
          const renderer = ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : '';
          if (!renderer) return null;
          if (/Apple\s*(M|GPU)/i.test(renderer)) return 'apple-silicon';
          if (/Intel/i.test(renderer)) return 'intel';
          return null;
        } catch (_) { return null; }
      }

      if (detectMacArch() === 'intel') applyCta(intel, 'intel');
    })();
  </script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('a[href*=".dmg"], a[href*=".exe"]').forEach(function (el) {
        el.addEventListener('click', function () {
          var arch = el.dataset.arch || 'unknown';
          var id = el.id;
          var location = id === 'primary-download' ? 'hero'
            : id === 'final-download' ? 'final_cta'
            : 'downloads_section';
          window.posthog?.capture('download_clicked', {
            arch: arch,
            location: location,
            version: '0.3.0'
          });
        });
      });

      var sayHello = document.querySelector('.founder-cta a[href="/talk"]');
      if (sayHello) {
        sayHello.addEventListener('click', function () {
          window.posthog?.capture('say_hello_clicked');
        });
      }
    });
  </script>

  <footer>
    <a href="/changelog/">What's new</a>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <a href="https://github.com/neha-prasad-ux/niyora">GitHub</a>
    <a href="mailto:neha@niyora.com">Contact</a>
    <div class="copyright">© 2026 Niyora. Built quietly in Norway.</div>
  </footer>
</Base>

<style>
  .content { position: relative; z-index: 2; }

  section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Compress hero so the feature cards peek into the first viewport,
     signalling there's more page below. */
  .hero {
    min-height: auto;
    padding: 80px 24px 36px;
    max-width: none;
    width: 100%;
  }
  @media (min-width: 900px) {
    .hero { padding: 80px 0 36px; }
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: hsla(var(--orb-hue), 50%, 75%, 0.7);
    margin-bottom: 16px;
    transition: color 1.4s ease;
  }

  h1 {
    font-size: 56px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    color: rgba(255, 255, 255, 0.96);
  }
  h2 {
    font-size: 38px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.94);
    max-width: 720px;
  }
  h3 {
    font-size: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 8px;
  }
  p {
    font-size: 17px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    max-width: 640px;
  }
  p.lead {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 36px;
  }
  p.afterword { margin-top: 36px; }

  .hero { text-align: center; }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
    width: 100%;
    max-width: 1100px;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(420px, 1fr) auto;
      gap: 64px;
      max-width: none;
      padding-left: clamp(24px, 4vw, 64px);
      padding-right: 0;
    }
    .hero-text { text-align: left; }
    .hero-text h1 { margin-left: 0; margin-right: 0; }
    .hero-text .subhead { margin-left: 0; margin-right: 0; }
    .hero-text .cta-row { justify-content: flex-start; }
    .hero-text .trust { align-items: flex-start; }
    .hero-text .trust-row,
    .hero-text .trust-strong { text-align: left; }
    .hero-image-wrap { justify-content: flex-end; }
    .hero-shot { border-radius: 14px 0 0 14px; }
  }
  .hero-image-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero .brand {
    font-size: 13px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 40px;
  }
  .hero h1 { font-size: 64px; }
  .hero .subhead {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 48px;
    max-width: 580px;
  }
  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .cta {
    display: inline-block;
    padding: 16px 36px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: rgba(18, 16, 32, 0.95);
    font-size: 16px;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    letter-spacing: 0.3px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    box-shadow:
      0 8px 32px hsla(var(--orb-hue), 60%, 55%, 0.35),
      0 0 64px hsla(var(--orb-hue), 60%, 60%, 0.2);
  }
  .cta:hover {
    transform: translateY(-2px) scale(1.02);
    background: rgba(255, 255, 255, 1);
    color: hsla(var(--orb-hue), 70%, 32%, 1);
    box-shadow:
      0 0 0 2px hsla(var(--orb-hue), 80%, 70%, 0.45),
      0 14px 48px hsla(var(--orb-hue), 80%, 60%, 0.75),
      0 0 100px hsla(var(--orb-hue), 80%, 65%, 0.45);
  }
  .cta.ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: none;
    color: rgba(255, 255, 255, 0.85);
  }
  .cta.ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.5); color: rgba(255, 255, 255, 1); }
  .meta { margin-top: 24px; font-size: 13px; color: rgba(255, 255, 255, 0.35); }

  .trust {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .trust-row {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.3px;
  }
  .trust-strong {
    font-size: 15px;
    font-weight: 500;
    color: hsla(var(--orb-hue), 60%, 82%, 0.95);
    letter-spacing: 0.3px;
    transition: color 1.4s ease;
  }

  .hero-shot {
    width: 100%;
    max-width: 540px;
    height: auto;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
