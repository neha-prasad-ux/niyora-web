  </footer>
</Base>

<style>
  .content { position: relative; z-index: 2; }

  section {
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 40px;
    max-width: 1080px;
    margin: 26px auto;
    border-radius: 32px;
    background: rgba(12, 10, 20, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.34);
  }
  @media (max-width: 720px) {
    section { margin: 14px; border-radius: 24px; }
  }

  /* Compress hero so the feature cards peek into the first viewport,
     signalling there's more page below. */
  .hero {
    min-height: 78vh;
    padding: 60px 40px 52px;
    animation: heroIn 1s ease 1s both;
  }
  /* The moon fades in first on the sky, then the hero glass comes over it. */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero { animation: none; }
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: hsla(var(--orb-hue), 50%, 75%, 0.7);
    margin-bottom: 16px;
    transition: color 1.4s ease;
  }

  h1 {
    font-size: 56px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
    color: rgba(255, 255, 255, 0.96);
  }
  h2 {
    font-size: 38px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin-bottom: 16px;
    color: rgba(255, 255, 255, 0.94);
    max-width: 720px;
  }
  h3 {
    font-size: 18px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 8px;
  }
  p {
    font-size: 17px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    max-width: 640px;
  }
  p.lead {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 36px;
  }
  p.afterword { margin-top: 36px; }

  .hero { text-align: center; }

  .hero-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 760px;
  }
  .hero-text { width: 100%; }

  .hero .brand {
    font-size: 13px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 40px;
  }
  .hero h1 { font-size: 64px; }
  .hero .subhead {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 auto 48px;
    max-width: 580px;
  }
  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .cta {
    display: inline-block;
    padding: 16px 36px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: rgba(18, 16, 32, 0.95);
    font-size: 16px;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    letter-spacing: 0.3px;
