    width: 100%;
    max-width: 980px;
  }
  .feature-card {
    padding: 24px 22px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(20, 18, 32, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-align: center;
  }
  .feature-card h3 {
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 8px;
  }
  .feature-card p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 auto;
    max-width: 100%;
  }

  #problem { text-align: center; }
  #problem h2 { margin-left: auto; margin-right: auto; }
  #problem .lead { margin-left: auto; margin-right: auto; }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 36px;
    width: 100%;
    max-width: 980px;
    text-align: left;
  }
  .research-card {
    padding: 24px 22px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(20, 18, 32, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .research-card h3 {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 10px;
  }
  .research-card p {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 14px;
  }
  .research-card .cite {
