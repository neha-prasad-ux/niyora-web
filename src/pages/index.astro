  @media (max-width: 899px) {
    .hero-shot { margin-top: 36px; max-width: 480px; }
  }

  .features {
    min-height: auto;
    padding: 100px 24px 100px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
