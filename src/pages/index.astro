---
import Base from '../layouts/Base.astro';
import OrbStage from '../components/OrbStage.astro';

const organization = {
  '@type': 'Organization',
  '@id': 'https://niyora.com/#organization',
  name: 'Niyora',
  url: 'https://niyora.com',
  logo: 'https://niyora.com/icon.png',
  sameAs: ['https://github.com/neha-prasad-ux/niyora'],
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...organization,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Niyora',
    url: 'https://apps.apple.com/app/niyora-pms-mood-relief/id6764561688',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS',
    description: 'Niyora predicts your PMS week and helps you reflect, regulate, and respond when your brain is reacting to a hormone drop.',
    image: 'https://assets.niyora.com/niyora-launch-poster.jpg',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    publisher: { '@id': 'https://niyora.com/#organization' },
  },
];
---

<Base
  title="Niyora · a PMS app that predicts, then helps you reflect, regulate, and respond"
  description="Niyora predicts your PMS week and helps you reflect, regulate, and respond when your brain is reacting to a hormone drop. Built on one fact: women with emotional regulation skills handle PMS better. Your personal details never reach the AI."
  ogImage="https://assets.niyora.com/niyora-launch-poster.jpg"
  canonicalUrl="https://niyora.com"
  jsonLd={jsonLd}
>
  <OrbStage />

  <main class="content">
    <section class="hero" data-hue="335" data-sat="58%" data-orb-alpha="0.9" data-orb-scale="0.9">
      <div class="hero-grid">
        <div class="hero-text">
          <h1>Life doesn't wait for PMS. But we do.</h1>
          <p class="subhead">Niyora is a PMS app that sees your week coming. When feelings run high, it helps you reflect, regulate, and respond, instead of react.</p>
          <div class="interest" id="interest">
            <button type="button" class="cta interest-btn" data-interest>I'm interested</button>
            <div class="interest-count" data-interest-count aria-live="polite" hidden></div>
          </div>
          <div class="trust">
            <div class="trust-row">Free · No account · No wearables · No cycle data shared</div>
            <div class="trust-strong" id="trust-tagline">Your personal details never reach the AI.</div>
          </div>
        </div>
      </div>
    </section>

    <section class="facts" data-hue="345" data-sat="56%">
      <div class="eyebrow">PMS is real and established</div>
      <h2>You don't have to prove any of this. It's already settled.</h2>
      <p class="lead">Research and surveys show PMS is near-universal, and the emotional side is the part most people carry alone.</p>
      <!-- TODO: add stat source line before publish (Neha to confirm) -->
      <div class="signals facts-grid">
        <div class="signal-card"><div class="num">3 in 4</div><p>women experience PMS</p></div>
        <div class="signal-card"><div class="num">95%</div><p>feel irritable</p></div>
        <div class="signal-card"><div class="num">93%</div><p>get mood swings</p></div>
        <div class="signal-card"><div class="num">82%</div><p>feel low</p></div>
        <div class="signal-card"><div class="num">65%</div><p>feel anxious</p></div>
        <div class="signal-card"><div class="num">78%</div><p>feel they are not taken seriously when they ask for help</p></div>
      </div>
      <p class="afterword lead">So Niyora doesn't try to convince you PMS is real. It predicts your window, gives you the skills and techniques to manage it, and takes you seriously, especially the 78% who feel dismissed.</p>
    </section>

    <section class="one-fact" data-hue="330" data-sat="55%">
      <div class="eyebrow">Built on one fact</div>
      <h2>Women with emotional regulation skills handle PMS better.</h2>
      <p class="lead">That's the whole idea. Staying steady is a skill, not something you're born with, and skills can be learned. Niyora teaches it a little at a time, so the week gets easier to carry.</p>
    </section>

    <section id="problem" data-hue="300" data-sat="55%">
      <div class="eyebrow">What no one told you</div>
      <h2>Your hormones are normal. Your brain just feels the shift more.</h2>
      <p class="lead">The difference between a hard PMS week and an easy one isn't your hormone levels. It's how strongly your brain responds to the same normal rise and fall. Two in three women feel it as mood swings.</p>
      <div class="research-grid">
        <div class="research-card">
          <h3>Same hormones, different response.</h3>
          <p>When researchers measured them, women who feel awful before their period had the same hormone levels as women who feel fine. The whole difference is sensitivity.</p>
          <div class="cite">NIMH · Schmidt &amp; Rubinow; Hantsoo &amp; Payne, 2020</div>
        </div>
        <div class="research-card">
          <h3>It's wired in, and it runs in families.</h3>
          <p>Premenstrual sensitivity is about 56 percent heritable. The same shift other people barely notice, your system actually feels. A bit like having sensitive skin.</p>
          <div class="cite">Dubey et al, Molecular Psychiatry, 2017</div>
        </div>
        <div class="research-card">
          <h3>It has an end date.</h3>
          <p>When researchers switched these hormones off, the symptoms cleared. When they switched them back on, they returned. It rolls in, and it rolls out, every cycle.</p>
          <div class="cite">NIMH GnRH add-back studies</div>
        </div>
      </div>
    </section>

    <section id="solution" data-hue="278" data-sat="55%">
      <div class="eyebrow">Moon AI · during PMS</div>
      <h2>Reflect. Regulate. Respond.</h2>
      <div class="solution-grid">
        <div class="solution-card">
          <div class="orb-mini orb-pulse"></div>
          <div class="card-eyebrow">Reflect</div>
          <h3>See it more than one way.</h3>
          <p>Tell Moon what happened. When you're upset, your mind locks onto one story. Moon shows you a few other ways to see it, so that one stops feeling like the truth.</p>
        </div>
        <div class="solution-card">
          <div class="orb-mini orb-breathe"></div>
          <div class="card-eyebrow">Regulate</div>
          <h3>Get through the twenty minutes.</h3>
          <p>A big wave of feeling takes about twenty minutes to pass. Moon gives you one small thing to do with your body to get through it, so it doesn't take over.</p>
        </div>
        <div class="solution-card">
          <div class="orb-mini orb-rings">
            <span class="ring r1"></span>
            <span class="ring r2"></span>
            <span class="ring r3"></span>
          </div>
          <div class="card-eyebrow">Respond</div>
          <h3>Send the one you won't regret.</h3>
          <p>Worked up, it's easy to say something you'll wish you hadn't. Moon writes a few ways you could reply, so you pick the one you'll feel good about, and actually send it.</p>
        </div>
      </div>
    </section>

    <section class="training" data-hue="258" data-sat="58%">
      <div class="eyebrow">Training · before PMS</div>
      <h2>Build the skill before you need it.</h2>
      <p class="lead">It's easier to stay steady when you've practised it calm. Short, playful lessons show you how to handle different feelings, so the skill is ready when you need it.</p>
      <div class="solution-grid">
        <div class="solution-card">
          <div class="card-eyebrow">At work</div>
          <h3>Handle the sharp email.</h3>
          <p>Learn to meet a hard meeting or a pointed message without it costing you the whole day.</p>
        </div>
        <div class="solution-card">
          <div class="card-eyebrow">Between people</div>
          <h3>Keep a small thing small.</h3>
          <p>Read a moment before you react, so a passing friction doesn't grow into something it wasn't.</p>
        </div>
        <div class="solution-card">
          <div class="card-eyebrow">With your partner</div>
          <h3>Name it without a fight.</h3>
          <p>Practise telling the difference between PMS and a real issue, and bringing it up so it lands well.</p>
        </div>
        <div class="solution-card">
          <div class="card-eyebrow">Real stories</div>
          <h3>Learn from how others handled it.</h3>
          <p>Work through real PMS moments and the way each was handled, so the lesson sticks better than any rule.</p>
        </div>
      </div>
    </section>

    <section class="relationships" data-hue="320" data-sat="58%">
      <div class="eyebrow">Couples</div>
      <h2>Is it PMS, or is it real? Either way, Niyora helps.</h2>
      <p class="lead">The week before your period, your reserves run thin and small things land sharp. It isn't that you love anyone less. When you steady yourself first, there's less to spill onto the people you care about.</p>
      <div class="solution-grid">
        <div class="solution-card">
          <div class="card-eyebrow">PMS or real?</div>
          <h3>Know which one you're in.</h3>
          <p>A quick read on whether the feeling is the week talking or a real thing to raise. Both are valid. Knowing which changes what you do next.</p>
        </div>
        <div class="solution-card">
          <div class="card-eyebrow">Say it well</div>
          <h3>A message, already written.</h3>
          <p>Tips and ready-to-send lines for the hard conversations, so a plain ask is easier to meet than a mood to read.</p>
        </div>
        <div class="solution-card">
          <div class="card-eyebrow">After a fight</div>
          <h3>Come back from it.</h3>
          <p>If it blew up, Niyora hands you a short, honest message to reopen it. One rough moment isn't the whole story.</p>
        </div>
      </div>
      <p class="more-line"><a href="/quiz/">Take the 2-minute check: how much is PMS affecting you? →</a></p>
      <p class="more-line"><a href="/blog/keeping-your-relationship-healthy-during-pms/">Read: keeping your relationship healthy during PMS →</a></p>
    </section>

    <section class="compare" data-hue="230" data-sat="60%">
      <div class="eyebrow">Why not just use ChatGPT</div>
      <h2>A frontier model keeps you talking. Moon helps you need it less.</h2>
      <p class="lead">General AI is built to hold your attention. That is the opposite of what a hard PMS moment needs. Here is the difference, line by line.</p>
      <div class="compare-grid">
        <div class="compare-head them">Any frontier model</div>
        <div class="compare-head us">Moon in Niyora</div>

        <div class="compare-cell them"><p>Built to keep the conversation going. It optimizes for time spent.</p></div>
        <div class="compare-cell us"><p>Built to finish the loop, then stop. It optimizes for you needing it less.</p></div>

        <div class="compare-cell them"><p>Agrees with you. That is what keeps you talking.</p></div>
        <div class="compare-cell us"><p>Shows you the other side on purpose. On your side, even when that means slowing you down.</p></div>

        <div class="compare-cell them"><p>Lets you vent for as long as you like. Research says venting often makes it worse.</p></div>
        <div class="compare-cell us"><p>Helps you regulate first, so you respond with something you won't regret.</p></div>

        <div class="compare-cell them"><p>Gives endless options and keeps going.</p></div>
        <div class="compare-cell us"><p>Gets you to one response you can stand behind, then stops.</p></div>

        <div class="compare-cell them"><p>Learns a lot about you, and is built to sound like a friend. That builds dependence.</p></div>
        <div class="compare-cell us"><p>No sign in, so you are never identifiable. It never calls itself human.</p></div>

        <div class="compare-cell them"><p>Doesn't know your PMS, and rarely raises how your actions land on others.</p></div>
        <div class="compare-cell us"><p>Built for your PMS week, and keeps the people around you in view.</p></div>
      </div>
      <p class="compare-close">No ads, no profile, nothing sold. There is no version of Niyora that makes money from your worst moment.</p>
    </section>

    <section data-hue="248" data-sat="62%">
      <div class="eyebrow">Research backed</div>
      <h2>Over 30 science-backed activities. Every one has a paper behind it.</h2>
      <p class="lead">No mystic wellness talk. Just practices drawn from peer-reviewed research, cited so you can read the source yourself. Niyora also recognises how strong your PMS is with a short test, and points to the lifestyle changes that actually move the needle.</p>
      <div class="papers">
        <div class="paper">
          <div class="title">Differential hormone sensitivity</div>
          <div class="cite">Schmidt et al, NEJM. PMDD brains react to normal hormone levels.</div>
        </div>
        <div class="paper">
          <div class="title">The heritable trait</div>
          <div class="cite">Dubey et al, 2017. Sensitivity is partly in your genes.</div>
        </div>
        <div class="paper">
          <div class="title">GABA and the calm brake</div>
          <div class="cite">Allopregnanolone shifts your built-in calm before your period.</div>
        </div>
        <div class="paper">
          <div class="title">Progressive muscle relaxation for PMS</div>
          <div class="cite">RCT. A large effect on premenstrual symptoms.</div>
        </div>
        <div class="paper">
          <div class="title">Calcium for PMS</div>
          <div class="cite">Thys-Jacobs crossover RCT. One of the strongest nutrient findings.</div>
        </div>
        <div class="paper">
          <div class="title">Recognised in 2013</div>
          <div class="cite">Dell'Osso et al, 2024. On average, women waited a decade for a name.</div>
        </div>
        <div class="paper">
          <div class="title">Box Breathing</div>
          <div class="cite">Used in Navy SEAL training. Lowers cortisol, improves HRV.</div>
        </div>
        <div class="paper">
          <div class="title">4-7-8 Breath</div>
          <div class="cite">Activates the parasympathetic nervous system. Weil, A.</div>
        </div>
        <div class="paper">
          <div class="title">5-4-3-2-1 Grounding</div>
          <div class="cite">Linehan, 1993 (DBT). Reduces panic and dissociation.</div>
        </div>
        <div class="paper">
          <div class="title">Self-Compassion</div>
          <div class="cite">Neff, 2003. Linked to reduced anxiety and rumination.</div>
        </div>
        <div class="paper">
          <div class="title">Alternate Nostril (Naadishodhana)</div>
          <div class="cite">Sharma et al, 2013. Lowers blood pressure, calms the system.</div>
        </div>
        <div class="paper">
          <div class="title">Ocean Breath (Ujjayi)</div>
          <div class="cite">Pal et al, 2011. Activates the vagus nerve, slows heart rate.</div>
        </div>
      </div>
      <p class="more-line">and more, every card in Niyora traces back to a source.</p>
    </section>

    <section data-hue="210" data-sat="60%">
      <div class="eyebrow">Private by design</div>
      <h2 id="privacy-tagline">Built to know almost nothing about you.</h2>
      <p class="lead">Your cycle and your feelings are the most personal data there is. Niyora is built so almost none of it reaches anyone, including the AI. Moon uses AI to write its reflections, so we're plain about exactly what it can and can't see.</p>
      <div class="privacy-points">
        <div class="privacy-point">
          <div class="check">✓</div>
          <h3>No sign in</h3>
          <p>No account, no login. Nothing you write is ever tied to your name.</p>
        </div>
        <div class="privacy-point">
          <div class="check">✓</div>
          <h3>Your details never reach the AI</h3>
          <p>Before your words go to Moon's AI, names and identifying details are stripped on your phone. What is left can't point back to you.</p>
        </div>
        <div class="privacy-point">
          <div class="check">✓</div>
          <h3>Nothing sold, nothing kept</h3>
          <p>No ads, no profile, no data sold. Your period dates stay on your device, and are never shared.</p>
        </div>
      </div>
    </section>

    <section class="founder" data-hue="335" data-sat="60%">
      <div class="eyebrow">Why I built Niyora</div>
      <img src="/neha.jpg" alt="Neha Prasad" class="founder-photo" loading="lazy" />
      <p class="quote">I went looking for a way through PMS that didn't ask me to change my body.</p>
      <p class="quote-body">I'm a doctor, so I started where I trust: the research. And the pattern was hard to miss. Most of what's offered for PMS either medicates it or tracks it and stops there. Niyora predicts your week too. The difference is what happens next: it helps you in the actual hard hour, where almost nothing else does.</p>
      <p class="quote-body">Then I found the quieter, stronger thread. The most reliable, least invasive way through a hard PMS week is emotion regulation. Learning to name what you feel, settle your body, and see the thought from a step back. No hormones to take, no device to wear, no data to hand over.</p>
      <p class="quote-body">That finding is the whole foundation of Niyora. Everything in the app is one small rep of emotion regulation, done in about a minute. I built it for myself first. Now it's yours.</p>
      <div class="signature">Neha Prasad. Doctor, builder, founder of Niyora.</div>
      <div class="founder-cta">
        <a href="/talk" class="cta ghost">Say hello</a>
      </div>
    </section>

    <section class="final-cta" data-hue="30" data-sat="70%">
      <h2>Want Niyora when you need it?</h2>
      <p class="lead">Tap to say you're interested. No email, no account, nothing to sign. Just a nudge that tells us to keep building.</p>
      <div class="interest">
        <button type="button" class="cta interest-btn" data-interest>I'm interested</button>
        <div class="interest-count" data-interest-count aria-live="polite" hidden></div>
      </div>
    </section>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // SEED is a starting count shown from day one. Real taps (via the KV
      // counter, once bound) add on top, so the number only ever grows. Before
      // KV exists, a tap bumps it locally so it still feels live. Change SEED
      // to whatever starting number you want.
      var SEED = 386;
      var buttons = document.querySelectorAll('[data-interest]');
      var counts = document.querySelectorAll('[data-interest-count]');
      var LS_KEY = 'niyora_interested';
      var LOCAL_KEY = 'niyora_interest_local';
      var current = 0; // amount shown on top of SEED right now
      var done = false, localExtra = 0;
      try { done = localStorage.getItem(LS_KEY) === '1'; } catch (e) {}
      try { localExtra = parseInt(localStorage.getItem(LOCAL_KEY) || '0', 10) || 0; } catch (e) {}

      function setText(extra) {
        counts.forEach(function (el) {
          el.textContent = (SEED + extra).toLocaleString('en-US') + ' interested';
          el.hidden = false;
        });
      }

      function animateTo(extra) {
        var from = current, t0 = null;
        function finish() { setText(extra); current = extra; }
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / 900, 1);
          setText(Math.round(from + (extra - from) * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step); else finish();
        }
        requestAnimationFrame(step);
        setTimeout(finish, 1000); // guarantee the value shows even if rAF is throttled (backgrounded tab)
      }

      function bump() {
        counts.forEach(function (el) { el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump'); });
      }

      function markDone() {
        buttons.forEach(function (b) { b.textContent = "You're in"; b.classList.add('is-done'); b.disabled = true; });
      }

      fetch('/api/interest').then(function (r) { return r.json(); })
        .then(function (d) { animateTo(typeof d.count === 'number' ? d.count : localExtra); if (done) markDone(); })
        .catch(function () { animateTo(localExtra); });

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (done) return;
          done = true;
          try { localStorage.setItem(LS_KEY, '1'); } catch (e) {}
          markDone();
          window.posthog?.capture('interest_clicked');
          function local() { localExtra += 1; try { localStorage.setItem(LOCAL_KEY, String(localExtra)); } catch (e) {} animateTo(localExtra); bump(); }
          fetch('/api/interest', { method: 'POST' }).then(function (r) { return r.json(); })
            .then(function (d) { if (typeof d.count === 'number') { animateTo(d.count); bump(); } else { local(); } })
            .catch(function () { local(); });
        });
      });

      var sayHello = document.querySelector('.founder-cta a[href="/talk"]');
      if (sayHello) {
        sayHello.addEventListener('click', function () {
          window.posthog?.capture('say_hello_clicked');
        });
      }
    });
  </script>

  <footer>
    <a href="/quiz/">PMS quiz</a>
