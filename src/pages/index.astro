  /* Animated mini-orb shared base */
  .orb-mini {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    margin-bottom: 22px;
    position: relative;
    background:
      radial-gradient(circle at 28% 24%, rgba(255, 255, 255, 0.55) 0%, transparent 36%),
      radial-gradient(circle at 35% 30%, #ffffff 0%, hsl(220, 25%, 92%) 42%, hsl(220, 38%, 78%) 92%, hsl(220, 42%, 74%) 100%);
    box-shadow:
      0 0 18px rgba(217, 146, 176, 0.45),
      0 0 34px rgba(156, 92, 134, 0.25);
    transition: box-shadow 1.4s ease;
  }

  /* Card 1: irregular pulse, like a heartbeat under load */
  @keyframes orbHeartbeat {
    0%, 30%, 60%, 100% { transform: scale(1); }
    8%  { transform: scale(1.12); }
    14% { transform: scale(1.04); }
    20% { transform: scale(1.10); }
    72% { transform: scale(1.06); }
    80% { transform: scale(1.02); }
  }
  .orb-pulse { animation: orbHeartbeat 3.4s ease-in-out infinite; }

  /* Card 2: slow box-breath in 4 / out 4 */
  @keyframes orbBreathe {
    0%, 100% { transform: scale(0.9); box-shadow: 0 0 12px hsla(var(--orb-hue), 60%, 50%, 0.3); }
    50%      { transform: scale(1.18); box-shadow: 0 0 32px hsla(var(--orb-hue), 70%, 65%, 0.7); }
  }
  .orb-breathe { animation: orbBreathe 8s ease-in-out infinite; }

  /* Card 3: concentric rings appearing one by one (the soul-tier echo) */
  .orb-rings { overflow: visible; }
  .orb-rings .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 1px solid hsla(var(--orb-hue), 60%, 70%, 0.55);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: border-color 1.4s ease;
  }
  .orb-rings .r1 { width: 80px;  height: 80px;  animation: ringFade 4.5s ease-in-out 0.0s infinite; }
  .orb-rings .r2 { width: 110px; height: 110px; animation: ringFade 4.5s ease-in-out 0.6s infinite; }
  .orb-rings .r3 { width: 140px; height: 140px; animation: ringFade 4.5s ease-in-out 1.2s infinite; }
  @keyframes ringFade {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.85); }
    35%  { opacity: 0.7; }
    70%  { opacity: 0.4; transform: translate(-50%, -50%) scale(1.0); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb-pulse, .orb-breathe { animation: none; }
    .orb-rings .ring { display: none; }
  }

