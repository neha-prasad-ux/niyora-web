---
import Page from '../layouts/Page.astro';
import { downloads } from '../config/downloads';

const organization = {
  '@type': 'Organization',
  '@id': 'https://niyora.com/#organization',
  name: 'Niyora',
  url: 'https://niyora.com',
  logo: 'https://niyora.com/icon.png',
  sameAs: ['https://github.com/neha-prasad-ux/niyora'],
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    ...organization,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Niyora',
    url: 'https://apps.apple.com/app/niyora-pms-mood-relief/id6764561688',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS',
    description: 'Niyora predicts your PMS week and helps you reflect, regulate, and respond when your brain is reacting to a hormone drop.',
    image: 'https://assets.niyora.com/niyora-launch-poster.jpg',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    publisher: { '@id': 'https://niyora.com/#organization' },
  },
];
---

<Page
  title="Niyora · a PMS app that predicts, then helps you through it"
  description="Niyora predicts your PMS week and helps you reflect, regulate, and respond when your brain is reacting to a hormone drop. Your details never reach the AI."
  ogImage="https://assets.niyora.com/niyora-launch-poster.jpg"
  canonicalUrl="https://niyora.com"
  jsonLd={jsonLd}
>

  <!-- Hero: copy sits over the moon that glows through the frost from behind. -->
  <section class="s hero">
    <div class="split">
      <div class="split-text">
        <h1>Life doesn't wait for PMS. But we do.</h1>
        <p class="subhead">Niyora is a PMS app that sees your week coming. When feelings run high, it helps you reflect, regulate, and respond, instead of react.</p>
        <div class="interest" id="interest">
          <button type="button" class="btn" data-interest>I'm interested</button>
          <div class="interest-count" data-interest-count aria-live="polite" hidden></div>
        </div>
        <div class="trust">
          <div class="trust-row">Free · No account · No wearables · No cycle data shared</div>
          <div class="trust-strong">Your personal details never reach the AI.</div>
        </div>
      </div>
      <div class="phone" role="img" aria-label="Niyora Moon home screen">
        <div class="phone-screen" style="background-image:url('/app/moon-home.png')"></div>
      </div>
    </div>
  </section>

  <!-- Stats facts -->
  <section class="s facts">
    <div class="eyebrow">PMS is real and established</div>
    <h2>You don't have to prove any of this. It's already settled.</h2>
    <p class="lead">Research and surveys show PMS is near-universal, and the emotional side is the part most people carry alone.</p>
    <div class="stats">
      <div class="stat"><div class="num">3 in 4</div><p>women experience PMS</p></div>
      <div class="stat"><div class="num">95%</div><p>feel irritable</p></div>
      <div class="stat"><div class="num">93%</div><p>get mood swings</p></div>
      <div class="stat"><div class="num">82%</div><p>feel low</p></div>
      <div class="stat"><div class="num">65%</div><p>feel anxious</p></div>
      <div class="stat"><div class="num">78%</div><p>feel they are not taken seriously when they ask for help</p></div>
    </div>
    <p class="afterword">So Niyora doesn't try to convince you PMS is real. It predicts your window, gives you the skills and techniques to manage it, and takes you seriously, especially the 78% who feel dismissed.</p>
  </section>

  <!-- Predict: calendar screen beside a short line. Tracking is a feature. -->
  <section class="s">
    <div class="split reverse">
      <div class="split-text">
        <div class="eyebrow">Predict</div>
        <h2>It sees your PMS window coming.</h2>
        <p class="lead">Tell Niyora when your period starts. It learns your rhythm and predicts the days ahead, so you can prepare before the week arrives instead of being caught off guard.</p>
      </div>
      <div class="phone" role="img" aria-label="Niyora period calendar screen">
        <div class="phone-screen" style="background-image:url('/app/calendar.png')"></div>
      </div>
    </div>
  </section>

  <!-- Problem: left-aligned on a wider measure for rhythm variety. -->
  <section class="s left">
    <div class="eyebrow">What no one told you</div>
    <h2>Your hormones are normal. Your brain just feels the shift more.</h2>
    <p class="lead">The difference between a hard PMS week and an easy one isn't your hormone levels. It's how strongly your brain responds to the same normal rise and fall. Two in three women feel it as mood swings.</p>
    <div class="cards three">
      <div class="card">
        <h3>Same hormones, different response.</h3>
        <p>When researchers measured them, women who feel awful before their period had the same hormone levels as women who feel fine. The whole difference is sensitivity.</p>
        <div class="cite">NIMH · Schmidt &amp; Rubinow; Hantsoo &amp; Payne, 2020</div>
      </div>
      <div class="card">
        <h3>It's wired in, and it runs in families.</h3>
        <p>Premenstrual sensitivity is about 56 percent heritable. The same shift other people barely notice, your system actually feels. A bit like having sensitive skin.</p>
        <div class="cite">Dubey et al, Molecular Psychiatry, 2017</div>
      </div>
      <div class="card">
        <h3>It has an end date.</h3>
        <p>When researchers switched these hormones off, the symptoms cleared. When they switched them back on, they returned. It rolls in, and it rolls out, every cycle.</p>
        <div class="cite">NIMH GnRH add-back studies</div>
      </div>
    </div>
  </section>

  <!-- Reflect. Regulate. Respond. -->
  <section class="s">
    <div class="eyebrow">Moon AI · during PMS</div>
    <h2>Reflect. Regulate. Respond.</h2>
    <div class="phone-trio">
      <figure class="phone-cap">
        <div class="phone" role="img" aria-label="Niyora Reflect screen">
          <div class="phone-screen" style="background-image:url('/app/reflect.png')"></div>
        </div>
        <figcaption>Reflect</figcaption>
      </figure>
      <figure class="phone-cap">
        <div class="phone" role="img" aria-label="Niyora Regulate screen">
          <div class="phone-screen" style="background-image:url('/app/regulate.png')"></div>
        </div>
        <figcaption>Regulate</figcaption>
      </figure>
      <figure class="phone-cap">
        <div class="phone" role="img" aria-label="Niyora Respond screen">
          <div class="phone-screen" style="background-image:url('/app/respond.png')"></div>
        </div>
        <figcaption>Respond</figcaption>
      </figure>
    </div>
    <div class="cards three">
      <div class="card">
        <div class="card-eyebrow">Reflect</div>
        <h3>See it more than one way.</h3>
        <p>Tell Moon what happened. When you're upset, your mind locks onto one story. Moon shows you a few other ways to see it, so that one stops feeling like the truth.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">Regulate</div>
        <h3>Get through the twenty minutes.</h3>
        <p>A big wave of feeling takes about twenty minutes to pass. Moon gives you one small thing to do with your body to get through it, so it doesn't take over.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">Respond</div>
        <h3>Send the one you won't regret.</h3>
        <p>Worked up, it's easy to say something you'll wish you hadn't. Moon writes a few ways you could reply, so you pick the one you'll feel good about, and actually send it.</p>
      </div>
    </div>
  </section>

  <!-- Training: left-aligned, two-column grid. -->
  <section class="s left">
    <div class="split">
      <div class="split-text">
        <div class="eyebrow">Training · before PMS</div>
        <h2>Build the skill before you need it.</h2>
        <p class="lead">It's easier to stay steady when you've practised it calm. Short, playful lessons show you how to handle different feelings, so the skill is ready when you need it.</p>
      </div>
      <div class="phone" role="img" aria-label="Niyora training path screen">
        <div class="phone-screen" style="background-image:url('/app/train.png')"></div>
      </div>
    </div>
    <div class="cards two">
      <div class="card">
        <div class="card-eyebrow">At work</div>
        <h3>Handle the sharp email.</h3>
        <p>Learn to meet a hard meeting or a pointed message without it costing you the whole day.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">Between people</div>
        <h3>Keep a small thing small.</h3>
        <p>Read a moment before you react, so a passing friction doesn't grow into something it wasn't.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">With your partner</div>
        <h3>Name it without a fight.</h3>
        <p>Practise telling the difference between PMS and a real issue, and bringing it up so it lands well.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">Real stories</div>
        <h3>Learn from how others handled it.</h3>
        <p>Work through real PMS moments and the way each was handled, so the lesson sticks better than any rule.</p>
      </div>
    </div>
  </section>

  <!-- Relationships -->
  <section class="s">
    <div class="split reverse">
      <div class="split-text">
        <div class="eyebrow">Couples</div>
        <h2>Is it PMS, or is it real? Either way, Niyora helps.</h2>
        <p class="lead">The week before your period, your reserves run thin and small things land sharp. It isn't that you love anyone less. When you steady yourself first, there's less to spill onto the people you care about.</p>
      </div>
      <div class="phone" role="img" aria-label="Niyora couples screen">
        <div class="phone-screen" style="background-image:url('/app/couples.png')"></div>
      </div>
    </div>
    <div class="cards three">
      <div class="card">
        <div class="card-eyebrow">PMS or real?</div>
        <h3>Know which one you're in.</h3>
        <p>A quick read on whether the feeling is the week talking or a real thing to raise. Both are valid. Knowing which changes what you do next.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">Say it well</div>
        <h3>A message, already written.</h3>
        <p>Tips and ready-to-send lines for the hard conversations, so a plain ask is easier to meet than a mood to read.</p>
      </div>
      <div class="card">
        <div class="card-eyebrow">After a fight</div>
        <h3>Come back from it.</h3>
        <p>If it blew up, Niyora hands you a short, honest message to reopen it. One rough moment isn't the whole story.</p>
      </div>
    </div>
    <p class="more-line"><a href="/quiz/">Take the 2-minute check: how much is PMS affecting you? →</a></p>
  </section>

  <!-- Your progress: soul screen beside a short line about growth over time. -->
  <section class="s">
    <div class="split">
      <div class="split-text">
        <div class="eyebrow">Your progress</div>
        <h2>Watch yourself grow steadier.</h2>
        <p class="lead">Every reflection and reply adds up. Niyora keeps track of what you've noticed, what you've applied, and your streak, and marks how far you've come with Moonstone tiers over time.</p>
      </div>
      {/* Phone hidden until there's a Soul capture without the dev overlay on it.
          Put the phone div back once /app/soul.png is reshot. */}
    </div>
  </section>

  <!-- Privacy -->
  <section class="s">
    <div class="eyebrow">Private by design</div>
    <h2>Built to know almost nothing about you.</h2>
    <p class="lead">Your cycle and your feelings are the most personal data there is. Niyora is built so almost none of it reaches anyone, including the AI. Moon uses AI to write its reflections, so we're plain about exactly what it can and can't see.</p>
    <div class="cards three">
      <div class="card">
        <div class="check">✓</div>
        <h3>No sign in</h3>
        <p>No account, no login. Nothing you write is ever tied to your name.</p>
      </div>
      <div class="card">
        <div class="check">✓</div>
        <h3>Your details never reach the AI</h3>
        <p>Before your words go to Moon's AI, names and identifying details are stripped on your phone. What is left can't point back to you.</p>
      </div>
      <div class="card">
        <div class="check">✓</div>
        <h3>Nothing sold, nothing kept</h3>
        <p>No ads, no profile, no data sold. Your period dates stay on your device, and are never shared.</p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="s final">
    <h2>Want Niyora when you need it?</h2>
    <p class="lead">Tap to say you're interested. No email, no account, nothing to sign. Just a nudge that tells us to keep building.</p>
    <div class="interest">
      <button type="button" class="btn" data-interest>I'm interested</button>
      <div class="interest-count" data-interest-count aria-live="polite" hidden></div>
    </div>
    <div class="final-links">
      <a class="btn store" href={downloads.appStore}>Get Niyora on the App Store</a>
      <a class="btn ghost" href="/quiz/">Take the 2-minute PMS check</a>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // SEED is a starting count shown from day one. Real taps (via the KV
      // counter, once bound) add on top, so the number only ever grows. Before
      // KV exists, a tap bumps it locally so it still feels live. Change SEED
      // to whatever starting number you want.
      var SEED = 386;
      var buttons = document.querySelectorAll('[data-interest]');
      var counts = document.querySelectorAll('[data-interest-count]');
      var LS_KEY = 'niyora_interested';
      var LOCAL_KEY = 'niyora_interest_local';
      var current = 0; // amount shown on top of SEED right now
      var done = false, localExtra = 0;
      try { done = localStorage.getItem(LS_KEY) === '1'; } catch (e) {}
      try { localExtra = parseInt(localStorage.getItem(LOCAL_KEY) || '0', 10) || 0; } catch (e) {}

      function setText(extra) {
        counts.forEach(function (el) {
          el.textContent = (SEED + extra).toLocaleString('en-US') + ' interested';
          el.hidden = false;
        });
      }

      function animateTo(extra) {
        var from = current, t0 = null;
        function finish() { setText(extra); current = extra; }
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / 900, 1);
          setText(Math.round(from + (extra - from) * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(step); else finish();
        }
        requestAnimationFrame(step);
        setTimeout(finish, 1000); // guarantee the value shows even if rAF is throttled (backgrounded tab)
      }

      function bump() {
        counts.forEach(function (el) { el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump'); });
      }

      function markDone() {
        buttons.forEach(function (b) { b.textContent = "You're in"; b.classList.add('is-done'); b.disabled = true; });
      }

      fetch('/api/interest').then(function (r) { return r.json(); })
        .then(function (d) { animateTo(typeof d.count === 'number' ? d.count : localExtra); if (done) markDone(); })
        .catch(function () { animateTo(localExtra); });

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (done) return;
          done = true;
          try { localStorage.setItem(LS_KEY, '1'); } catch (e) {}
          markDone();
          window.posthog?.capture('interest_clicked');
          function local() { localExtra += 1; try { localStorage.setItem(LOCAL_KEY, String(localExtra)); } catch (e) {} animateTo(localExtra); bump(); }
          fetch('/api/interest', { method: 'POST' }).then(function (r) { return r.json(); })
            .then(function (d) { if (typeof d.count === 'number') { animateTo(d.count); bump(); } else { local(); } })
            .catch(function () { local(); });
        });
      });
    });
  </script>
</Page>

<style>
  /* ── Hero ── */
  .hero { padding-top: 64px; }
  .subhead {
    font-size: 20px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    max-width: 560px;
    margin: 0 auto 36px;
  }

  /* ── Interest button + live count ── */
  .interest {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .interest-count {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.3px;
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }
  /* Real counter's bump() adds .bump on each successful tap. */
  .interest-count.bump { animation: interestBump 0.4s ease; }
  @keyframes interestBump {
    0% { transform: scale(1); }
    40% { transform: scale(1.14); color: rgba(244, 178, 203, 1); }
    100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .interest-count.bump { animation: none; }
  }

  .trust {
    margin-top: 34px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .trust-row { font-size: 14px; color: rgba(255, 255, 255, 0.55); letter-spacing: 0.3px; }
  .trust-strong {
    font-size: 15px;
    font-weight: 500;
    color: rgba(244, 178, 203, 0.92);
    letter-spacing: 0.3px;
  }

  .final-links {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 32px;
  }

  /* ── Stats ── */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
    text-align: center;
  }
  .stat {
    padding: 22px 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
  }
  .stat .num {
    font-size: 30px;
    font-weight: 500;
    color: rgba(244, 178, 203, 0.95);
    margin-bottom: 8px;
  }
  .stat p { font-size: 14px; color: rgba(255, 255, 255, 0.62); }

  /* ── Card grids (three / two columns) ── */
  .cards {
    display: grid;
    gap: 16px;
    margin-top: 40px;
    text-align: left;
  }
  .cards.three { grid-template-columns: repeat(3, 1fr); }
  .cards.two { grid-template-columns: repeat(2, 1fr); }
  .card {
    padding: 26px 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
  }
  .card p { font-size: 14px; line-height: 1.6; color: rgba(255, 255, 255, 0.65); }
  .card-eyebrow {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(244, 178, 203, 0.82);
    margin-bottom: 10px;
  }
  .card .cite {
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 0.4px;
    color: rgba(244, 178, 203, 0.75);
  }
  .card .check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(244, 178, 203, 0.18);
    border: 1px solid rgba(244, 178, 203, 0.5);
    color: rgba(244, 178, 203, 1);
    font-size: 13px;
    margin-bottom: 12px;
  }

  .more-line {
    margin-top: 30px;
    font-size: 15px;
  }
  .more-line a { color: rgba(244, 178, 203, 0.9); text-decoration: none; }
  .more-line a:hover { text-decoration: underline; }

  /* ── Thin phone frame ──
     A reusable vertical iPhone: thin dark bezel, soft cool/violet outer glow so
     it sits in the cosmic sky. The SCREEN is a div with a background-image
     rather than an image element, and a dark fallback colour, so a missing file
     degrades to a plain dark screen instead of a broken-image icon. */
  .phone {
    flex: 0 0 auto;
    width: 236px;
    aspect-ratio: 9 / 19.5;
    padding: 9px;                 /* bezel thickness -> ~218px screen */
    border-radius: 44px;
    background: #0b0912;
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(150, 120, 220, 0.22),   /* faint violet glow into the sky */
      inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 36px;
    background-color: #0a0814;    /* dark fallback if the PNG is missing */
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  /* ── Two-column split: section text on one side, phone on the other ──
     .reverse alternates which side the phone sits on. Stacks on mobile. */
  .split {
    display: flex;
    align-items: center;
    gap: 48px;
    max-width: 800px;
    margin: 0 auto;
  }
  .split.reverse { flex-direction: row-reverse; }
  .split-text { flex: 1 1 auto; min-width: 0; text-align: left; }
  .split-text h1,
  .split-text h2,
  .split-text .subhead,
  .split-text .lead,
  .split-text p { margin-left: 0; margin-right: 0; max-width: none; }
  .split-text .lead { margin-bottom: 0; }
  .split-text .interest { align-items: flex-start; }

  /* ── Phone trio: the Reflect / Regulate / Respond core loop ── */
  .phone-trio {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 44px;
  }
  .phone-cap { margin: 0; text-align: center; }
  .phone-cap .phone { width: 216px; }
  .phone-cap figcaption {
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(244, 178, 203, 0.82);
  }

  /* ── Responsive ── */
  @media (max-width: 760px) {
    .s { padding: 56px 28px; }
    h1 { font-size: 36px; }
    h2 { font-size: 26px; }
    .subhead { font-size: 18px; }
    .lead { font-size: 17px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .cards.three, .cards.two { grid-template-columns: 1fr; }
    /* Stack the two-column splits, phone under the copy, both centered. */
    .split, .split.reverse { flex-direction: column; gap: 36px; }
    .split-text { text-align: center; }
    .split-text .interest { align-items: center; }
    .phone { width: 210px; }
  }
  @media (max-width: 420px) {
    .s { padding: 48px 20px; }
    .stats { grid-template-columns: 1fr; }
    .phone { width: 200px; }
    .phone-cap .phone { width: 200px; }
  }
</style>
