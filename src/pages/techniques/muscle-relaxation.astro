  { name: 'Techniques', href: '/techniques/' },
  { name: 'Muscle relaxation', href: '/techniques/muscle-relaxation/' },
]);

const medical = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Progressive muscle relaxation for PMS',
  description:
    'How to run progressive muscle relaxation for premenstrual symptoms, muscle group by muscle group, and what the 2024 randomized trial does and does not show.',
