---
import Base from '../../layouts/Base.astro';
import Sky from '../../components/Sky.astro';
import Moon from '../../components/Moon.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { downloads } from '../../config/downloads';
import { QUESTIONS, OPTIONS, BANDS, MAX_SCORE } from './_score';

// The client only needs the band thresholds and hue to place the marker and
// tint accents. Copy already lives in the DOM (rendered below), single source.
const bandMeta = BANDS.map((b) => ({ id: b.id, label: b.label, min: b.min, max: b.max, hue: b.hue }));
---

<Base
  title="How much is PMS affecting you? A free PMS quiz · Niyora"
  description="A free 2 minute PMS quiz. Answer 8 questions and see whether your PMS is mild, noticeable, or high impact, plus what actually helps the week before your period. A self-check, not a diagnosis."
  ogImage="https://assets.niyora.com/niyora-launch-poster.jpg"
  canonicalUrl="https://niyora.com/quiz"
>
  <Sky />
  <Moon />

  <main class="quiz-wrap">
    <a class="back" href="/">← Niyora</a>

    <section class="stage" data-hue="300" data-sat="55%" data-orb-alpha="0.6" data-orb-scale="0.92">
      <!-- Intro -->
      <div class="view" data-view="intro">
        <div class="eyebrow">A 2 minute self-check</div>
        <h1>How much is PMS affecting you?</h1>
        <p class="lead">
          Wondering if your PMS is normal, or how much the week before your period is really taking?
          Answer 8 quick questions. You will get an honest read, mild, noticeable, or high impact,
          and what actually helps. Free, no account, nothing to install.
        </p>
        <button type="button" class="cta" data-start>Start the quiz</button>
        <p class="fineprint">This is a quick self-check, not a medical diagnosis. It cannot diagnose PMS or PMDD.</p>
      </div>

      <!-- Quiz -->
      <div class="view" data-view="quiz" hidden>
        <div class="progress">
          <div class="dots" aria-hidden="true">
            {QUESTIONS.map(() => <span class="dot"></span>)}
          </div>
          <div class="count" data-count aria-live="polite"></div>
        </div>

        <div class="questions">
          {QUESTIONS.map((q, i) => (
            <div class="question" data-question={i} hidden>
              <div class="q-eyebrow">{q.eyebrow}</div>
              <p class="q-text">{q.text}</p>
              <div class="options" role="group" aria-label={q.text}>
                {OPTIONS.map((o) => (
                  <button type="button" class="option" data-value={o.value}>{o.label}</button>
                ))}
              </div>
            </div>
          ))}
        </div>

        <button type="button" class="link-btn" data-back hidden>← Back</button>
      </div>

      <!-- Result -->
      <div class="view" data-view="result" hidden>
        <div class="eyebrow">Your result</div>
        <h2 class="result-head" data-result-head tabindex="-1"></h2>

        <div class="meter" aria-hidden="true">
          <div class="meter-track">
            <span class="meter-zone z-mild"></span>
            <span class="meter-zone z-noticeable"></span>
            <span class="meter-zone z-high"></span>
            <span class="meter-marker" data-marker></span>
          </div>
          <div class="meter-labels">
            <span>Mild</span><span>Noticeable</span><span>High impact</span>
          </div>
        </div>

        {BANDS.map((b) => (
          <div class="band" data-band={b.id} data-headline={b.headline} hidden>
            <p class="band-body">{b.body}</p>
            {b.note && <p class="band-note">{b.note}</p>}
          </div>
        ))}

        <!-- Free guide hook (captured via PostHog, no backend) -->
        <div class="offer">
          <div class="offer-eyebrow">Free</div>
          <h3>Get the short PMS guide</h3>
          <p>One short email: how to steady the week before your period, drawn from the research, no fluff. Plus first word when Niyora opens up.</p>
          <form class="lead-form" data-lead novalidate>
            <input type="email" name="email" placeholder="you@email.com" autocomplete="email" required aria-label="Your email" data-email />
            <button type="submit" class="cta">Send me the guide</button>
            <p class="form-msg" data-msg role="status" aria-live="polite" hidden></p>
          </form>
          <p class="offer-now"><a href="/guide/">Prefer to read it now? Open the guide →</a></p>
        </div>

        <!-- Soft app link, never a gate on the result above -->
        <div class="app-link">
          <p>Niyora is a private iPhone app for exactly these days. No account, and your personal details never reach the AI.</p>
          <a href={downloads.appStore} class="cta ghost" data-app>Get Niyora for iPhone</a>
        </div>

        <button type="button" class="link-btn center" data-restart>Retake the quiz</button>
        <p class="fineprint">
          This is a quick self-check, not a medical diagnosis. It cannot diagnose PMS or PMDD.
          If your symptoms worry you, a doctor can help.
        </p>
      </div>
    </section>
  </main>

  <script define:vars={{ bandMeta, maxScore: MAX_SCORE, total: QUESTIONS.length }}>
    document.addEventListener('DOMContentLoaded', function () {
      var stage = document.querySelector('.stage');
      if (!stage) return;

      // The shared Sky + Moon chrome has no section observer, so seed the quiz's
      // baseline accent hue (pink). finish()/restart override this per band.
      document.documentElement.style.setProperty('--orb-hue', '300');

      var views = {};
      stage.querySelectorAll('[data-view]').forEach(function (v) { views[v.dataset.view] = v; });
      var questions = Array.prototype.slice.call(stage.querySelectorAll('[data-question]'));
      var dots = Array.prototype.slice.call(stage.querySelectorAll('.dot'));
      var countEl = stage.querySelector('[data-count]');
      var backBtn = stage.querySelector('[data-back]');

      var answers = new Array(total).fill(null);
      var current = 0;

      function showView(name) {
        Object.keys(views).forEach(function (k) { views[k].hidden = k !== name; });
      }

      function renderStep() {
        questions.forEach(function (q, i) { q.hidden = i !== current; });
        dots.forEach(function (d, i) {
          d.classList.toggle('filled', answers[i] !== null);
          d.classList.toggle('active', i === current);
        });
        countEl.textContent = 'Question ' + (current + 1) + ' of ' + total;
        backBtn.hidden = current === 0;
        var q = questions[current];
        q.querySelectorAll('.option').forEach(function (o) {
          o.classList.toggle('selected', Number(o.dataset.value) === answers[current]);
        });
      }

      function finish() {
        var sum = answers.reduce(function (a, b) { return a + (b || 0); }, 0);
        var band = bandMeta.find(function (b) { return sum >= b.min && sum <= b.max; }) || bandMeta[bandMeta.length - 1];

        stage.querySelectorAll('[data-band]').forEach(function (el) { el.hidden = el.dataset.band !== band.id; });
        var head = stage.querySelector('[data-result-head]');
        var bandEl = stage.querySelector('[data-band="' + band.id + '"]');
        // Headline copy lives in _score.ts; mirror the band label into the heading.
        head.textContent = band.label + '. ' + (bandEl && bandEl.dataset.headline ? bandEl.dataset.headline : '');

        var pct = Math.round((sum / maxScore) * 100);
        var marker = stage.querySelector('[data-marker]');
        if (marker) marker.style.left = pct + '%';

        document.documentElement.style.setProperty('--orb-hue', String(band.hue));

        stage.dataset.band = band.id;
        showView('result');
        head.focus();
        if (window.posthog) window.posthog.capture('quiz_completed', { band: band.id, score: sum });
      }

      stage.querySelector('[data-start]').addEventListener('click', function () {
        showView('quiz');
        renderStep();
      });

      questions.forEach(function (q, i) {
        q.querySelectorAll('.option').forEach(function (opt) {
          opt.addEventListener('click', function () {
            answers[i] = Number(opt.dataset.value);
            if (current < total - 1) { current += 1; renderStep(); }
            else finish();
          });
        });
      });

      backBtn.addEventListener('click', function () {
        if (current > 0) { current -= 1; renderStep(); }
      });

      stage.querySelector('[data-restart]').addEventListener('click', function () {
        answers = new Array(total).fill(null);
        current = 0;
        delete stage.dataset.band;
        document.documentElement.style.setProperty('--orb-hue', '300');
        showView('intro');
      });

      // Email capture: PostHog only, per the founder decision. No backend.
      var form = stage.querySelector('[data-lead]');
      var emailInput = stage.querySelector('[data-email]');
      var msg = stage.querySelector('[data-msg]');
      var validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function showMsg(text, ok) {
        msg.textContent = text;
        msg.hidden = false;
        msg.classList.toggle('ok', !!ok);
        msg.classList.toggle('err', !ok);
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var email = (emailInput.value || '').trim();
        if (!validEmail.test(email)) { showMsg('That email does not look right. Mind checking it?', false); return; }
        var band = stage.dataset.band || 'unknown';
        if (window.posthog) {
          window.posthog.identify(email, { email: email });
          window.posthog.capture('quiz_lead', { email: email, band: band });
        }
        form.querySelector('button[type="submit"]').disabled = true;
        emailInput.disabled = true;
        showMsg("You're on the list. The guide lands in your inbox when Niyora opens up.", true);
      });

      stage.querySelector('[data-app]').addEventListener('click', function () {
        if (window.posthog) window.posthog.capture('quiz_app_clicked', { band: stage.dataset.band || 'unknown' });
      });
    });
  </script>

  <SiteFooter />
</Base>

<style>
  .quiz-wrap {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }
  .back {
    display: inline-block;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    margin-bottom: 28px;
    letter-spacing: 0.3px;
  }
  .back:hover { color: rgba(255, 255, 255, 0.85); }

  .stage {
    border-radius: 28px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    padding: 48px 40px 44px;
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  @media (max-width: 640px) {
    .stage { padding: 34px 22px 32px; border-radius: 22px; }
    .quiz-wrap { padding: 28px 16px 0; }
  }

  .view { animation: fade 0.5s ease both; }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .view { animation: none; } }

  .eyebrow, .offer-eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: hsla(var(--orb-hue), 50%, 78%, 0.75);
    margin-bottom: 16px;
    transition: color 1.4s ease;
  }

  h1 {
    font-size: 44px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.5px;
    color: rgba(255, 255, 255, 0.96);
    margin-bottom: 18px;
  }
  .lead {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 32px;
    max-width: 560px;
  }
  .fineprint {
    margin-top: 26px;
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.42);
    max-width: 540px;
  }

  .cta {
    display: inline-block;
    padding: 15px 34px;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: rgba(18, 16, 32, 0.95);
    font-size: 16px;
    font-weight: 500;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    box-shadow: 0 8px 32px hsla(var(--orb-hue), 60%, 55%, 0.32), 0 0 64px hsla(var(--orb-hue), 60%, 60%, 0.18);
  }
  .cta:hover {
    transform: translateY(-2px) scale(1.02);
    color: hsla(var(--orb-hue), 70%, 32%, 1);
    box-shadow: 0 0 0 2px hsla(var(--orb-hue), 80%, 70%, 0.4), 0 14px 48px hsla(var(--orb-hue), 80%, 60%, 0.6);
  }
  .cta.ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.24);
    box-shadow: none;
    color: rgba(255, 255, 255, 0.88);
  }
  .cta.ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.5); color: #fff; }
  .cta:disabled { opacity: 0.55; cursor: default; transform: none; box-shadow: none; }

  .link-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    cursor: pointer;
    padding: 6px 0;
    margin-top: 28px;
    align-self: flex-start;
  }
  .link-btn.center { align-self: center; margin-top: 36px; }
  .link-btn:hover { color: rgba(255, 255, 255, 0.9); }

  /* Progress */
  .progress { display: flex; align-items: center; justify-content: space-between; margin-bottom: 34px; }
  .dots { display: flex; gap: 8px; }
  .dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.16);
    transition: background 0.4s ease, transform 0.4s ease, box-shadow 0.4s ease;
  }
  .dot.filled { background: hsla(var(--orb-hue), 60%, 72%, 0.9); border-color: transparent; }
  .dot.active { transform: scale(1.35); box-shadow: 0 0 12px hsla(var(--orb-hue), 65%, 70%, 0.6); }
  .count { font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }

  .q-eyebrow {
    font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
    color: hsla(var(--orb-hue), 55%, 78%, 0.8); margin-bottom: 14px;
    transition: color 1.4s ease;
  }
  .q-text {
    font-size: 26px; font-weight: 400; line-height: 1.35;
    color: rgba(255, 255, 255, 0.95); margin-bottom: 30px; max-width: 620px;
  }
  @media (max-width: 640px) { .q-text { font-size: 21px; } h1 { font-size: 33px; } }

  .options { display: grid; gap: 12px; }
  .option {
    text-align: left;
    padding: 16px 20px;
    border-radius: 14px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg-soft);
    color: rgba(255, 255, 255, 0.85);
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.15s ease;
  }
  .option:hover {
    border-color: hsla(var(--orb-hue), 55%, 65%, 0.55);
    background: hsla(var(--orb-hue), 40%, 40%, 0.18);
  }
  .option.selected {
    border-color: hsla(var(--orb-hue), 60%, 68%, 0.8);
    background: hsla(var(--orb-hue), 50%, 45%, 0.25);
    color: #fff;
  }

  /* Result */
  h2.result-head {
    font-size: 30px; font-weight: 400; line-height: 1.3;
    color: rgba(255, 255, 255, 0.96); margin-bottom: 28px; outline: none;
    letter-spacing: -0.3px;
  }
  @media (max-width: 640px) { h2.result-head { font-size: 24px; } }

  .meter { margin-bottom: 30px; }
  .meter-track {
    position: relative;
    height: 10px;
    border-radius: 6px;
    display: flex;
    overflow: visible;
  }
  .meter-zone { height: 100%; }
  .z-mild { flex: 6; background: hsla(210, 55%, 60%, 0.55); border-radius: 6px 0 0 6px; }
  .z-noticeable { flex: 9; background: hsla(280, 55%, 62%, 0.55); }
  .z-high { flex: 9; background: hsla(335, 60%, 62%, 0.6); border-radius: 0 6px 6px 0; }
  .meter-marker {
    position: absolute;
    top: 50%;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #fff;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 4px rgba(7, 6, 15, 0.6), 0 0 18px hsla(var(--orb-hue), 70%, 70%, 0.8);
    transition: left 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .meter-labels {
    display: flex; justify-content: space-between;
    margin-top: 10px;
    font-size: 11px; letter-spacing: 1px; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  .band-body {
    font-size: 17px; font-weight: 300; line-height: 1.7;
    color: rgba(255, 255, 255, 0.78); margin-bottom: 16px;
  }
  .band-note {
    font-size: 14px; line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid hsla(335, 55%, 62%, 0.4);
    background: hsla(335, 45%, 40%, 0.16);
  }

  .offer, .app-link {
    margin-top: 30px;
    padding: 26px 24px;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg-soft);
  }
  .offer h3, .app-link p { color: rgba(255, 255, 255, 0.92); }
  .offer h3 { font-size: 20px; font-weight: 500; margin-bottom: 8px; }
  .offer > p { font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.65); margin-bottom: 18px; }
  .offer-eyebrow { margin-bottom: 10px; }

  .lead-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .lead-form input[type="email"] {
    flex: 1;
    min-width: 200px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    background: rgba(7, 6, 15, 0.4);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 15px;
  }
  .lead-form input[type="email"]:focus {
    outline: none;
    border-color: hsla(var(--orb-hue), 60%, 65%, 0.7);
  }
  .lead-form input[type="email"]:disabled { opacity: 0.55; }
  .form-msg { width: 100%; margin: 6px 0 0; font-size: 14px; }
  .form-msg.ok { color: hsla(var(--orb-hue), 60%, 82%, 0.95); }
  .form-msg.err { color: hsla(4, 70%, 74%, 0.95); }

  .app-link { margin-top: 16px; text-align: center; }
  .app-link p { font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.7); margin-bottom: 16px; }
</style>

<!-- Moon.astro reads these with no fallback; mirror Page.astro's :root so the
     shared Sky + Moon chrome renders identically to the rest of the site.
     ponytail: duplicated 3 tokens, dedupe if the quiz ever wraps in <Page>. -->
<style is:global>
  :root {
    --sky-bg: #0a0814;
    --moon-glow: radial-gradient(circle,
      rgba(255, 168, 108, 0.55) 0%,
      rgba(246, 148, 190, 0.40) 32%,
      rgba(168, 104, 214, 0.22) 54%,
      rgba(168, 104, 214, 0.08) 72%,
      rgba(168, 104, 214, 0) 88%);
    --moon-face: radial-gradient(circle at 42% 38%, #f7f5fb 0%, #eceaf3 52%, #dddbe8 100%);
  }
</style>
