---
import Page from '../../layouts/Page.astro';
import { downloads } from '../../config/downloads';
import { breadcrumbs } from '../../components/_breadcrumbs';
import { allRows, grouped, pagedClusters, sourceLabel } from './_clusters';

const groups = grouped();
const paged = new Set(pagedClusters().map((g) => g.cluster.slug));
const strong = allRows.filter((r) => r.grade === 'strong').length;

const crumbs = breadcrumbs([{ name: 'Research', href: '/research/' }]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The research behind Niyora',
  description:
  'Every research finding Niyora is built on, graded strong, moderate or weak, with the paper behind it.',
  url: 'https://niyora.com/research/',
  citation: allRows.filter((r) => r.link).map((r) => r.link),
  hasPart: groups.map(({ cluster }) => ({
  '@type': 'WebPageElement',
  name: cluster.title,
  url: `https://niyora.com/research/#${cluster.slug}`,
  })),
};

// The same findings the page shows, declared as a dataset with a real download
// so Google Dataset Search can index them. License is CC BY 4.0: the papers are
// everyone's, the grading and the plain-language line are ours to give away.
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'The graded evidence behind Niyora',
  description: `${allRows.length} findings on PMS, PMDD and the menstrual cycle, each graded strong, moderate or weak, with the paper behind it and a plain-language reading of what it means.`,
  url: 'https://niyora.com/research/',
  creator: { '@type': 'Organization', name: 'Niyora', url: 'https://niyora.com/' },
  publisher: { '@type': 'Organization', name: 'Niyora', url: 'https://niyora.com/' },
  keywords: ['PMS', 'PMDD', 'premenstrual', 'menstrual cycle', 'emotional regulation', 'evidence grading'],
  variableMeasured: ['Topic', 'Finding', 'Evidence grade', 'Source', 'Plain-language summary'],
  citation: allRows.filter((r) => r.link).map((r) => r.link),
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  distribution: [
    {
      '@type': 'DataDownload',
      name: 'Niyora graded research findings (JSON)',
      encodingFormat: 'application/json',
      contentUrl: 'https://niyora.com/data/research.json',
    },
  ],
};
---

<Page
  title="The research behind Niyora, graded · Niyora"
  description={`Every finding Niyora is built on, in one table: what the study found, how good the evidence really is, and a link to the paper. ${allRows.length} findings, ${strong} of them strong.`}
  canonicalUrl="https://niyora.com/research/"
  jsonLd={[jsonLd, dataset, crumbs]}
>
  <section class="s hero">
    <div class="eyebrow">Research</div>
    <h1>Every study behind Niyora, graded honestly</h1>
    <p class="lead">
      Everything in this app comes from a paper. All {allRows.length} of them are here, with what
      the study found and how good the evidence really is. Some of it is strong. Some of it is
      thin, and I would rather tell you than quietly leave it out.
    </p>
  </section>

  <section class="s">
    <h2>How I grade these</h2>
    <div class="grade-grid">
      <div class="grade-card">
        <span class="badge strong">Strong</span>
        <p>A randomized trial, or a review of them. About as close to proof as this field gets.</p>
      </div>
      <div class="grade-card">
        <span class="badge moderate">Moderate</span>
        <p>
          A big observational study, a cell study, or a review that lines up. A real signal, not a
          proven cause.
        </p>
      </div>
      <div class="grade-card">
        <span class="badge weak">Weak</span>
        <p>
          Small, mixed, argued over, or borrowed from a related field. It is here because leaving
          it out would be the dishonest move.
        </p>
      </div>
    </div>
    <p class="note">
      I do not write "studies show" without a link. If a finding is a correlation, I say so.
    </p>
    <div class="cta-row">
      <a href="/research/gaps/" class="btn ghost">See what nobody has studied yet</a>
      <a href="/research/trials/" class="btn ghost">Trials you could join</a>
    </div>
  </section>

  <section class="s">
    <h2>What are you here for</h2>
    <div class="jump-grid">
      {groups.map(({ cluster, rows }) => (
        <a href={`#${cluster.slug}`} class="jump-card">
          <span class="jump-title">{cluster.title}</span>
          <span class="jump-count">{rows.length} {rows.length === 1 ? 'finding' : 'findings'}</span>
        </a>
      ))}
    </div>
  </section>

  {groups.map(({ cluster, rows }) => (
    <section class="s cluster" id={cluster.slug}>
      <h2>{cluster.title}</h2>
      <p class="question">{cluster.question}</p>
      <p class="lead">{cluster.intro}</p>

      <ol class="evidence">
        {rows.map((row) => (
          <li class="finding">
            <div class="finding-head">
              <span class={`badge ${row.grade.replace('-', ' ').split(' ')[0]}`}>{row.grade}</span>
              <span class="topic">{row.topic}</span>
            </div>
            <p class="plain">{row.plain}</p>
            <p class="detail">{row.finding}</p>
            <p class="source">
              {row.link ? (
                <a href={row.link} rel="noopener nofollow" target="_blank">{sourceLabel(row)}</a>
              ) : (
                <span>{sourceLabel(row)}</span>
              )}
            </p>
          </li>
        ))}
      </ol>

      <div class="cta-row">
        {paged.has(cluster.slug) && (
          <a href={`/research/${cluster.slug}/`} class="btn ghost">{cluster.title} in full</a>
        )}
        {cluster.related.map((link) => (
          <a href={link.href} class="btn ghost">{link.label}</a>
        ))}
      </div>
    </section>
  ))}

  <section class="s">
    <h2>This is what the app runs on</h2>
    <p class="lead">
      Niyora turns all of this into three steps you can use in the moment. Reflect on what
      happened, regulate in about a minute, respond with a clearer head.
    </p>
    <div class="cta-row">
      <a href="/quiz/" class="btn">Take the quiz</a>
      <a href={downloads.appStore} class="btn ghost">Get Niyora</a>
    </div>
  </section>
</Page>

<style>
  /* Page-specific only: grade badges, the jump grid and the evidence list.
     Shared chrome (sheet, sections, dividers, type scale, buttons, footer)
     comes from Page. */
  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .badge.strong { color: hsl(152, 52%, 66%); background: hsla(152, 52%, 40%, 0.14); }
  .badge.moderate { color: hsl(44, 70%, 68%); background: hsla(44, 70%, 45%, 0.13); }
  .badge.weak { color: hsl(20, 55%, 70%); background: hsla(20, 55%, 45%, 0.13); }

  .grade-grid, .jump-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: 100%;
    max-width: 900px;
    margin: 24px auto 0;
    text-align: left;
  }
  .grade-card, .jump-card {
    padding: 20px 20px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .grade-card p { font-size: 14px; line-height: 1.6; margin: 12px 0 0; }
  .jump-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .jump-card:hover { border-color: rgba(var(--accent-rgb), 0.4); transform: translateY(-2px); }
  .jump-title { font-size: 16px; color: rgba(255, 255, 255, 0.9); }
  .jump-count { font-size: 12px; color: rgba(255, 255, 255, 0.45); letter-spacing: 1px; }

  .note { font-size: 14px; margin-top: 22px; color: rgba(255, 255, 255, 0.5); }
  .question { font-size: 15px; color: rgba(var(--accent-rgb), 0.85); margin-bottom: 14px; }

  .s.cluster { scroll-margin-top: 80px; }

  .evidence {
    list-style: none;
    width: 100%;
    max-width: 860px;
    margin: 26px auto 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .finding {
    padding: 22px 22px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .finding-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .topic { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }
  .plain { font-size: 19px; line-height: 1.5; color: rgba(255, 255, 255, 0.92); margin-bottom: 10px; }
  .detail { font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.6); }
  .source { font-size: 13px; margin-top: 14px; color: rgba(255, 255, 255, 0.38); }
  .source a { color: rgba(255, 255, 255, 0.6); text-decoration: underline; text-underline-offset: 3px; }
  .source a:hover { color: rgba(255, 255, 255, 0.95); }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 28px; }

  @media (max-width: 900px) {
    .grade-grid, .jump-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 720px) {
    .s { padding: 56px 24px; }
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
    .plain { font-size: 17px; }
    .grade-grid, .jump-grid { grid-template-columns: 1fr; }
    .finding { padding: 18px 16px 16px; }
  }
</style>
