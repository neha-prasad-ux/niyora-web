---
import Page from '../../layouts/Page.astro';
import { downloads } from '../../config/downloads';
import { pagedClusters, sourceLabel, type Cluster, type ResearchRow } from './_clusters';

export function getStaticPaths() {
  return pagedClusters().map(({ cluster, rows }) => ({
  params: { cluster: cluster.slug },
  props: { cluster, rows },
  }));
}

interface Props {
  cluster: Cluster;
  rows: ResearchRow[];
}

const { cluster, rows } = Astro.props;
const url = `https://niyora.com/research/${cluster.slug}/`;
const strongest = rows[0].grade;

const jsonLd = [
  {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: cluster.title,
  description: cluster.intro,
  url,
  citation: rows.filter((r) => r.link).map((r) => r.link),
  },
  {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: cluster.question,
      acceptedAnswer: { '@type': 'Answer', text: `${cluster.intro} ${rows[0].plain}` },
    },
  ],
  },
];
---

<Page
  title={`${cluster.title}: what the research says · Niyora`}
  description={`${cluster.question} ${cluster.intro}`}
  canonicalUrl={url}
  jsonLd={jsonLd}
>
  <section class="s hero">
    <div class="eyebrow"><a href="/research/">Research</a></div>
    <h1>{cluster.question}</h1>
    <p class="lead">{cluster.intro}</p>
    <p class="meta">
      {rows.length} findings. Best evidence here: <strong>{strongest}</strong>.
    </p>
  </section>

  <section class="s cluster">
    <h2>{cluster.title}</h2>
    <ol class="evidence">
      {rows.map((row) => (
        <li class="finding">
          <div class="finding-head">
            <span class={`badge ${row.grade.split('-')[0]}`}>{row.grade}</span>
            <span class="topic">{row.topic}</span>
          </div>
          <p class="plain">{row.plain}</p>
          <p class="detail">{row.finding}</p>
          <p class="source">
            {row.link ? (
              <a href={row.link} rel="noopener nofollow" target="_blank">{sourceLabel(row)}</a>
            ) : (
              <span>{sourceLabel(row)}</span>
            )}
          </p>
        </li>
      ))}
    </ol>
    <p class="note">
      The grades are mine, applied the same way to every row.
      <a href="/research/">See how I grade</a> and read the rest of the table.
    </p>
  </section>

  {cluster.related.length > 0 && (
    <section class="s">
      <h2>Keep reading</h2>
      <div class="cta-row">
        {cluster.related.map((link) => (
          <a href={link.href} class="btn ghost">{link.label}</a>
        ))}
      </div>
    </section>
  )}

  <section class="s">
    <h2>Knowing why only helps if you can use it</h2>
    <p class="lead">
      Niyora turns this into three steps for when it actually hits. Reflect on what happened,
      regulate in about a minute, respond with a clearer head.
    </p>
    <div class="cta-row">
      <a href="/quiz/" class="btn">Take the quiz</a>
      <a href={downloads.appStore} class="btn ghost">Get Niyora</a>
    </div>
  </section>
</Page>

<style>
  /* Page-specific only: grade badges and the evidence list. Shared chrome
     (sheet, sections, dividers, type scale, buttons, footer) comes from Page. */
  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { color: rgba(255, 255, 255, 0.95); }
  .meta { font-size: 14px; margin-top: 18px; color: rgba(255, 255, 255, 0.45); }
  .meta strong { font-weight: 500; color: rgba(255, 255, 255, 0.75); }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .badge.strong { color: hsl(152, 52%, 66%); background: hsla(152, 52%, 40%, 0.14); }
  .badge.moderate { color: hsl(44, 70%, 68%); background: hsla(44, 70%, 45%, 0.13); }
  .badge.weak { color: hsl(20, 55%, 70%); background: hsla(20, 55%, 45%, 0.13); }

  .evidence {
    list-style: none;
    width: 100%;
    max-width: 860px;
    margin: 26px auto 8px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .finding {
    padding: 22px 22px 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .finding-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .topic { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }
  .plain { font-size: 19px; line-height: 1.5; color: rgba(255, 255, 255, 0.92); margin-bottom: 10px; }
  .detail { font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.6); }
  .source { font-size: 13px; margin-top: 14px; color: rgba(255, 255, 255, 0.38); }
  .source a { color: rgba(255, 255, 255, 0.6); text-decoration: underline; text-underline-offset: 3px; }
  .source a:hover { color: rgba(255, 255, 255, 0.95); }

  .note { font-size: 14px; margin-top: 22px; color: rgba(255, 255, 255, 0.5); }
  .note a { color: rgba(255, 255, 255, 0.7); }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 28px; }

  @media (max-width: 720px) {
    .s { padding: 56px 24px; }
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
    .plain { font-size: 17px; }
    .finding { padding: 18px 16px 16px; }
  }
</style>
