---
import Base from '../../layouts/Base.astro';
import OrbStage from '../../components/OrbStage.astro';
import { downloads } from '../../config/downloads';
import { pagedClusters, sourceLabel, type Cluster, type ResearchRow } from './_clusters';

export function getStaticPaths() {
  return pagedClusters().map(({ cluster, rows }) => ({
    params: { cluster: cluster.slug },
    props: { cluster, rows },
  }));
}

interface Props {
  cluster: Cluster;
  rows: ResearchRow[];
}

const { cluster, rows } = Astro.props;
const url = `https://niyora.com/research/${cluster.slug}/`;
const strongest = rows[0].grade;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: cluster.title,
    description: cluster.intro,
    url,
    citation: rows.filter((r) => r.link).map((r) => r.link),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: cluster.question,
        acceptedAnswer: { '@type': 'Answer', text: `${cluster.intro} ${rows[0].plain}` },
      },
    ],
  },
];
---

<Base
  title={`${cluster.title}: what the research says · Niyora`}
  description={`${cluster.question} ${cluster.intro}`}
  canonicalUrl={url}
  jsonLd={jsonLd}
>
  <OrbStage />

  <main class="content">
    <section class="hero" data-hue="248" data-sat="55%">
      <div class="eyebrow"><a href="/research/">Research</a></div>
      <h1>{cluster.question}</h1>
      <p class="lede">{cluster.intro}</p>
      <p class="meta">
        {rows.length} findings. Strongest evidence here: <strong>{strongest}</strong>.
      </p>
    </section>

    <section class="cluster-section" data-hue="300" data-sat="52%">
      <h2>{cluster.title}</h2>
      <ol class="evidence">
        {rows.map((row) => (
          <li class="finding">
            <div class="finding-head">
              <span class={`badge ${row.grade.split('-')[0]}`}>{row.grade}</span>
              <span class="topic">{row.topic}</span>
            </div>
            <p class="plain">{row.plain}</p>
            <p class="detail">{row.finding}</p>
            <p class="source">
              {row.link ? (
                <a href={row.link} rel="noopener nofollow" target="_blank">{sourceLabel(row)}</a>
              ) : (
                <span>{sourceLabel(row)}</span>
              )}
            </p>
          </li>
        ))}
      </ol>
      <p class="note">
        Grades are ours, applied the same way to every row. <a href="/research/">See how we grade</a>
        and read the rest of the table.
      </p>
    </section>

    {cluster.related.length > 0 && (
      <section class="related-section" data-hue="248" data-sat="55%">
        <h2>Keep reading</h2>
        <div class="cta-row">
          {cluster.related.map((link) => (
            <a href={link.href} class="cta ghost">{link.label}</a>
          ))}
        </div>
      </section>
    )}

    <section class="cta-section" data-hue="30" data-sat="70%">
      <h2>Knowing why only helps if it reaches the moment</h2>
      <p class="lede">
        Niyora turns this into three steps you can use when it lands. Reflect on what happened,
        regulate in about a minute, respond with a clearer head.
      </p>
      <div class="cta-row">
        <a href="/quiz/" class="cta">Take the quiz</a>
        <a href={downloads.appStore} class="cta ghost">Get Niyora</a>
      </div>
    </section>
  </main>

  <footer>
    <a href="/research/">All research</a>
    <a href="/blog/">Writing</a>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <div class="copyright">© 2026 Niyora. Built quietly in Norway.</div>
  </footer>
</Base>

<style>
  .content { position: relative; z-index: 2; }

  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 72px 40px;
    max-width: 1080px;
    margin: 26px auto;
    border-radius: 32px;
    background: rgba(12, 10, 20, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.34);
    text-align: center;
  }
  @media (max-width: 720px) {
    section { margin: 14px; border-radius: 24px; padding: 56px 20px; }
  }

  .hero { padding: 96px 40px 80px; }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: hsla(var(--orb-hue), 50%, 75%, 0.7);
    margin-bottom: 16px;
    transition: color 1.4s ease;
  }
  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { color: rgba(255, 255, 255, 0.95); }

  h1 {
    font-size: 48px;
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.5px;
    margin-bottom: 22px;
    max-width: 780px;
    color: rgba(255, 255, 255, 0.96);
  }
  h2 {
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin-bottom: 12px;
    max-width: 720px;
    color: rgba(255, 255, 255, 0.94);
  }
  p { font-size: 17px; font-weight: 300; color: rgba(255, 255, 255, 0.66); max-width: 640px; }
  p.lede { font-size: 20px; color: rgba(255, 255, 255, 0.74); line-height: 1.55; }
  p.meta { font-size: 14px; margin-top: 18px; color: rgba(255, 255, 255, 0.45); }
  p.meta strong { font-weight: 500; color: rgba(255, 255, 255, 0.75); }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .badge.strong { color: hsl(152, 52%, 66%); background: hsla(152, 52%, 40%, 0.14); }
  .badge.moderate { color: hsl(44, 70%, 68%); background: hsla(44, 70%, 45%, 0.13); }
  .badge.weak { color: hsl(20, 55%, 70%); background: hsla(20, 55%, 45%, 0.13); }

  .evidence {
    list-style: none;
    width: 100%;
    max-width: 860px;
    text-align: left;
    margin: 26px 0 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .finding {
    padding: 24px 24px 20px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--glass-bg);
    box-shadow: var(--glass-shadow);
  }
  .finding-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .topic {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }
  .finding p { max-width: none; }
  .plain {
    font-size: 19px;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 10px;
  }
  .detail { font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.6); }
  .source { font-size: 13px; margin-top: 14px; color: rgba(255, 255, 255, 0.38); }
  .source a { color: rgba(255, 255, 255, 0.6); text-decoration: underline; text-underline-offset: 3px; }
  .source a:hover { color: rgba(255, 255, 255, 0.95); }
  .note { font-size: 14px; margin-top: 22px; color: rgba(255, 255, 255, 0.5); }
  .note a { color: rgba(255, 255, 255, 0.7); }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
  .cta {
    display: inline-block;
    padding: 16px 36px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: rgba(18, 16, 32, 0.95);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.3px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    box-shadow: 0 8px 32px hsla(var(--orb-hue), 60%, 55%, 0.35), 0 0 64px hsla(var(--orb-hue), 60%, 60%, 0.2);
  }
  .cta:hover {
    transform: translateY(-2px) scale(1.02);
    background: rgba(255, 255, 255, 1);
    color: hsla(var(--orb-hue), 70%, 32%, 1);
    box-shadow: 0 0 0 2px hsla(var(--orb-hue), 80%, 70%, 0.45), 0 14px 48px hsla(var(--orb-hue), 80%, 60%, 0.75);
  }
  .cta.ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: none;
    color: rgba(255, 255, 255, 0.85);
    padding: 13px 26px;
    font-size: 15px;
  }
  .cta.ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.5); color: rgba(255, 255, 255, 1); }

  footer {
    text-align: center;
    padding: 60px 24px 80px;
    color: rgba(255, 255, 255, 0.3);
    font-size: 13px;
    position: relative;
    z-index: 2;
  }
  footer a { color: rgba(255, 255, 255, 0.45); text-decoration: none; margin: 0 14px; }
  footer a:hover { color: rgba(255, 255, 255, 0.8); }
  footer .copyright { margin-top: 16px; font-size: 12px; color: rgba(255, 255, 255, 0.2); }

  @media (max-width: 720px) {
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
    p.lede { font-size: 17px; }
    .plain { font-size: 17px; }
    .finding { padding: 20px 18px 18px; }
  }
</style>
