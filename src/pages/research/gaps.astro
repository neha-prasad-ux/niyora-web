---
import Page from '../../layouts/Page.astro';
import { downloads } from '../../config/downloads';
import { lanes, logPosition, stats, TICKS, laneByName } from './_gaps';

// Chart geometry, in SVG user units. The container scrolls horizontally on
// narrow screens rather than shrinking the labels into illegibility.
const ROW = 27;
const LABEL_W = 232;
const PAD_R = 58;
const WIDTH = 820;
const TOP = 52;
const PLOT_W = WIDTH - LABEL_W - PAD_R;
const HEIGHT = TOP + lanes.length * ROW + 16;
const x = (v: number) => LABEL_W + logPosition(v) * PLOT_W;

const moon = laneByName('Lunar / moon myth');
const geo = laneByName('Geographical');
const animals = laneByName('PMS in animals');
const suicide = laneByName('Self-harm / suicidality');
const genetic = laneByName('Genetic');
const env = laneByName('Environmental');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Research volume and trial evidence across menstrual health topics',
  description: `Europe PMC literature counts for ${stats.laneCount} menstrual and premenstrual health topics, with the number of randomized trials, meta-analyses and systematic reviews in each.`,
  url: 'https://niyora.com/research/gaps/',
  creator: { '@type': 'Organization', name: 'Niyora' },
  isBasedOn: 'https://europepmc.org/',
  temporalCoverage: '2026-08-16',
  variableMeasured: ['Papers published', 'Trials and systematic reviews'],
};
---

<Page
  title="What nobody has studied about your cycle · Niyora"
  description={`I counted the published research across ${stats.laneCount} menstrual health topics. ${env.total} papers exist on hormone disruptors and cycle mood. ${genetic.total} on genetics, and not one randomized trial.`}
  canonicalUrl="https://niyora.com/research/gaps/"
  jsonLd={jsonLd}
>
  <section class="s hero">
    <div class="eyebrow"><a href="/research/">Research</a></div>
    <h1>What nobody has studied about your cycle</h1>
    <p class="lead">
      I asked Europe PMC how much research exists on {stats.laneCount} questions about the
      menstrual cycle, and how much of it was a real trial. The answers are not spread evenly,
      and the empty spots are the point.
    </p>
  </section>

  <section class="s">
    <div class="stat-grid">
      <div class="stat">
        <div class="stat-num">{env.total}</div>
        <p>
          papers on plastics, pollution and hormone disruptors affecting cycle mood. That is the
          whole literature.
        </p>
      </div>
      <div class="stat">
        <div class="stat-num">0</div>
        <p>
          randomized trials on the genetics of premenstrual symptoms, out of {genetic.total}{' '}
          papers. Genetics is the root of the whole thing.
        </p>
      </div>
      <div class="stat">
        <div class="stat-num">{Math.round(animals.total / suicide.total)}×</div>
        <p>
          more research on the cycle in animals ({animals.total.toLocaleString()}) than on
          premenstrual self-harm and suicide ({suicide.total}).
        </p>
      </div>
    </div>
    <p class="note">
      There are also {moon.total} papers on the moon and the menstrual cycle, and {geo.total} on
      whether where you live changes your symptoms.
    </p>
  </section>

  <section class="s">
    <h2>Every topic, and how much of it got tested</h2>
    <p class="lead">
      Each row is one search. The purple dot on the right is how many papers exist. The green dot
      on the left is how many were real trials. The space between them is the gap.
    </p>

    <div class="legend">
      <span class="legend-item"><span class="key key-total"></span> All papers</span>
      <span class="legend-item"><span class="key key-strong"></span> Trials and reviews</span>
      <span class="legend-item"><span class="key key-zero"></span> None at all</span>
    </div>

    <div class="chart-scroll">
      <svg
        class="chart"
        viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
        width={WIDTH}
        height={HEIGHT}
        role="img"
        aria-label={`Chart of ${stats.laneCount} menstrual health research topics, showing total papers against trials and reviews. Every figure is in the table below.`}
      >
        {TICKS.map((t) => (
          <g class="tick">
            <line x1={x(t)} y1={TOP - 24} x2={x(t)} y2={HEIGHT - 8} />
            <text x={x(t)} y={TOP - 30} text-anchor="middle">{t.toLocaleString()}</text>
          </g>
        ))}
        <text class="axis-title" x="0" y={16}>papers published (log scale)</text>

        {lanes.map((lane, i) => {
          const y = TOP + i * ROW + ROW / 2;
          const xTotal = x(lane.total);
          const xStrong = lane.strong > 0 ? x(lane.strong) : LABEL_W;
          return (
            <g class="row">
              <title>{`${lane.lane}: ${lane.total.toLocaleString()} papers, ${lane.strong} trials or reviews`}</title>
              <rect class="row-hit" x="0" y={y - ROW / 2} width={WIDTH} height={ROW} />
              <text class="row-label" x={LABEL_W - 12} y={y + 4} text-anchor="end">{lane.lane}</text>
              <line class="connector" x1={xStrong} y1={y} x2={xTotal} y2={y} />
              {lane.strong > 0 ? (
                <circle class="dot dot-strong" cx={xStrong} cy={y} r="5" />
              ) : (
                <circle class="dot dot-zero" cx={LABEL_W} cy={y} r="5" />
              )}
              <circle class="dot dot-total" cx={xTotal} cy={y} r="5" />
              <text class="row-value" x={xTotal + 12} y={y + 4}>{lane.total.toLocaleString()}</text>
            </g>
          );
        })}
      </svg>
    </div>

    <p class="note">
      On a phone, scroll the chart sideways. Every number is in the table below.
    </p>
  </section>

  <section class="s">
    <h2>The numbers</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Topic</th>
            <th scope="col" class="num">Papers</th>
            <th scope="col" class="num">Trials and reviews</th>
            <th scope="col" class="num">Share</th>
          </tr>
        </thead>
        <tbody>
          {lanes.map((lane) => (
            <tr>
              <th scope="row">{lane.lane}</th>
              <td class="num">{lane.total.toLocaleString()}</td>
              <td class={lane.strong === 0 ? 'num zero' : 'num'}>{lane.strong}</td>
              <td class="num">
                {lane.strong === 0 ? 'none' : `${((lane.strong / lane.total) * 100).toFixed(1)}%`}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="s">
    <h2>How I counted, and what this is not</h2>
    <div class="science">
      <p>
        Each topic is one search I ran against Europe PMC on August 16, 2026, matching on title
        and abstract. The number is that search's total hit count. "Trials and reviews" is the
        same search, filtered to randomized controlled trials, meta-analyses and systematic
        reviews.
      </p>
      <p>
        This is not a systematic review, and a search is only ever a rough proxy. Word it broadly
        and you get more back. Word it narrowly and you get less. So read these as the shape of a
        field, not an exact count. I ran the same method on every topic, so comparing one row to
        another is fair even where a single number is rough.
      </p>
      <p>
        I left out {58 - stats.laneCount} other searches about women at work, because those are
        not cycle-specific and the numbers are not comparable to these.
      </p>
    </div>
    <div class="cta-row">
      <a href="/research/" class="btn ghost">See the research that does exist</a>
    </div>
  </section>

  <section class="s">
    <h2>This is why I grade everything</h2>
    <p class="lead">
      When a field is this thin, confident advice is the warning sign. Niyora shows you the
      evidence behind every claim it makes, including the weak stuff.
    </p>
    <div class="cta-row">
      <a href="/quiz/" class="btn">Take the quiz</a>
      <a href={downloads.appStore} class="btn ghost">Get Niyora</a>
    </div>
  </section>
</Page>

<style>
  /* Page-specific only: the stat row, the dot chart, the table and the method
     block. Shared chrome (sheet, sections, dividers, type scale, buttons,
     footer) comes from Page. */
  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { color: rgba(255, 255, 255, 0.95); }
  .note { font-size: 14px; margin-top: 22px; color: rgba(255, 255, 255, 0.5); }

  /* Data ink. Validated on the cosmic surface: adjacent CVD dE 18.2, normal 18.6.
     The muted step sits under 3:1, so every mark carries a visible value label
     and the full table below repeats the figures. */
  .chart, .legend {
    --series-total: #9085e9;
    --series-strong: #199e70;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: 100%;
    max-width: 940px;
    margin: 0 auto;
    text-align: left;
  }
  .stat {
    padding: 24px 22px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }
  .stat-num {
    font-size: 52px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -1px;
    color: rgba(255, 255, 255, 0.96);
    margin-bottom: 14px;
  }
  .stat p { font-size: 15px; line-height: 1.55; }

  .legend {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
    margin: 26px 0 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
  }
  .legend-item { display: inline-flex; align-items: center; gap: 8px; }
  .key { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .key-total { background: var(--series-total); }
  .key-strong { background: var(--series-strong); }
  .key-zero { border: 2px solid rgba(255, 255, 255, 0.5); }

  .chart-scroll {
    width: 100%;
    max-width: 900px;
    margin: 12px auto 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .chart { display: block; min-width: 820px; max-width: 100%; height: auto; }
  .tick line { stroke: rgba(255, 255, 255, 0.09); stroke-width: 1; }
  .tick text { fill: rgba(255, 255, 255, 0.42); font-size: 11px; font-family: inherit; }
  .axis-title { fill: rgba(255, 255, 255, 0.42); font-size: 11px; letter-spacing: 1px; font-family: inherit; }
  .row-hit { fill: transparent; }
  .row:hover .row-hit { fill: rgba(255, 255, 255, 0.04); }
  .row-label { fill: rgba(255, 255, 255, 0.72); font-size: 12.5px; font-family: inherit; }
  .row-value { fill: rgba(255, 255, 255, 0.55); font-size: 11.5px; font-family: inherit; }
  .connector { stroke: rgba(255, 255, 255, 0.2); stroke-width: 2; }
  .dot { stroke: #0b0912; stroke-width: 2; }
  .dot-total { fill: var(--series-total); }
  .dot-strong { fill: var(--series-strong); }
  .dot-zero { fill: none; stroke: rgba(255, 255, 255, 0.5); stroke-width: 2; }

  .table-scroll { width: 100%; max-width: 860px; margin: 20px auto 0; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; }
  th, td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--hairline);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.72);
  }
  thead th {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    font-weight: 400;
  }
  tbody th { font-weight: 300; color: rgba(255, 255, 255, 0.86); }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .zero { color: hsl(20, 60%, 72%); }

  .science {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 30px;
    border-radius: 20px;
    border: 1px solid rgba(var(--accent-rgb), 0.28);
    background: rgba(255, 255, 255, 0.03);
    text-align: left;
  }
  .science p { font-size: 16px; line-height: 1.65; color: rgba(255, 255, 255, 0.78); margin: 0 0 16px; }
  .science p:last-child { margin-bottom: 0; }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 28px; }

  @media (max-width: 900px) { .stat-grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .s { padding: 56px 24px; }
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
    .stat-num { font-size: 42px; }
  }
</style>
