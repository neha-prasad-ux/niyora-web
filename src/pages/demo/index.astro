---
import Page from '../../layouts/Page.astro';
import { downloads } from '../../config/downloads';
---

<Page
  title="Niyora in motion"
  description="30 seconds of pranayama. No tour, no tutorial. Just one breath."
  ogImage="https://assets.niyora.com/niyora-launch-poster.jpg"
  canonicalUrl="https://niyora.com/demo"
>
  <section class="s">
    <a class="back" href="/">← Back to Niyora</a>
    <div class="eyebrow">See it in motion</div>
    <h1>Niyora in motion</h1>
    <p class="lead">30 seconds of pranayama. No tour, no tutorial. Just one breath.</p>
  </section>

  <section class="s">
    <div class="video-frame">
      <video
        autoplay
        muted
        controls
        playsinline
        poster="https://assets.niyora.com/niyora-launch-poster.jpg"
        src="https://assets.niyora.com/niyora-launch.mp4"
        aria-label="Niyora breathing session: box breathing with orb shifting colour each phase"
      >
        <p>Your browser does not support the video element. <a href="https://assets.niyora.com/niyora-launch.mp4">Download the demo video</a>.</p>
      </video>
    </div>

    <ul class="watch-list">
      <li>Box breathing technique</li>
      <li>Tier-tinted orb shifts colour each phase</li>
      <li>All on-device, no analytics</li>
    </ul>

    <div class="cta-row">
      <a id="demo-download" href={downloads.apple} class="btn" data-arch="apple-silicon">
        Download for Mac
      </a>
      <a href="mailto:hello@niyora.com?subject=iOS%20app%20launch%20notification" class="btn ghost">Notify me for iOS</a>
    </div>
    <p class="other-builds">Other builds at <a href="/">niyora.com</a>.</p>
  </section>

  <script define:vars={{ apple: downloads.apple, intel: downloads.intel, windows: downloads.windows }}>
    (function () {
      const a = document.getElementById('demo-download');
      if (!a) return;

      const isWindows = /Windows/i.test(navigator.userAgent);
      if (isWindows) {
        a.href = windows;
        a.dataset.arch = 'windows-x64';
        a.textContent = 'Download for Windows';
        return;
      }

      const isMac = /Mac|iPhone|iPad/i.test(navigator.userAgent);
      if (!isMac) return;

      function detectMacArch() {
        try {
          const canvas = document.createElement('canvas');
          const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
          if (!gl) return null;
          const ext = gl.getExtension('WEBGL_debug_renderer_info');
          const renderer = ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : '';
          if (!renderer) return null;
          if (/Apple\s*(M|GPU)/i.test(renderer)) return 'apple-silicon';
          if (/Intel/i.test(renderer)) return 'intel';
          return null;
        } catch (_) { return null; }
      }

      if (detectMacArch() === 'intel') {
        a.href = intel;
        a.dataset.arch = 'intel';
      }
    })();
  </script>
</Page>

<style>
  .back {
    display: inline-block;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: none;
    margin-bottom: 32px;
    letter-spacing: 0.3px;
  }
  .back:hover { color: rgba(255, 255, 255, 0.8); }

  /* Page-specific: the video frame. */
  .video-frame {
    width: 100%;
    max-width: 800px;
    margin: 0 auto 40px;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    background: #000;
    aspect-ratio: 16 / 9;
  }
  .video-frame video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .watch-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 40px;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }
  .watch-list li {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.65);
    padding: 12px 16px;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    background: var(--glass-bg-soft);
  }
  .watch-list li::before {
    content: "→ ";
    color: rgba(255, 255, 255, 0.3);
  }

  .cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .other-builds {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
    margin-top: 20px;
  }
  .other-builds a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .video-frame { border-radius: 10px; }
  }
</style>
