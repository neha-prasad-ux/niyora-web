---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Hello · Niyora"
  ogImage="https://assets.niyora.com/niyora-launch-poster.jpg"
  canonicalUrl="https://niyora.com/talk/"
>
  <div class="container">
    <a class="back" href="/">← Back to Niyora</a>

    <h1>Hello!</h1>

    <p class="lede">
      I’m Neha, the founder of Niyora.
    </p>

    <p>
      If you’ve tried Niyora and something felt helpful, unclear, or worth
      improving, I’d love to hear from you. Your feedback helps shape Niyora
      into something calmer, simpler, and more useful.
    </p>

    <p>
      For ideas, thoughts, or anything else, my inbox is open. You can also
      say hi on LinkedIn, I’d be happy to chat.
    </p>

    <p class="email">
      <a href="mailto:neha@niyora.com?subject=Niyora">neha@niyora.com</a>
    </p>

    <div class="links">
      <a class="link" href="https://www.linkedin.com/in/dr-neha-prasad/" target="_blank" rel="noopener noreferrer">Find me on LinkedIn</a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var emailLink = document.querySelector('p.email a');
      if (emailLink) {
        emailLink.addEventListener('click', function () {
          window.posthog?.capture('contact_link_clicked', { method: 'email' });
        });
      }

      var linkedinLink = document.querySelector('a.link[href*="linkedin.com"]');
      if (linkedinLink) {
        linkedinLink.addEventListener('click', function () {
          window.posthog?.capture('contact_link_clicked', { method: 'linkedin' });
        });
      }
    });
  </script>
</Base>

<style>
  body { background: #0a0814; }
  .container {
    max-width: 640px;
    margin: 0 auto;
    padding: 60px 24px 80px;
    color: rgba(255, 255, 255, 0.78);
  }
  a.back {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: none;
    font-size: 13px;
    display: inline-block;
    margin-bottom: 32px;
  }
  a.back:hover { color: rgba(255, 255, 255, 0.6); }

  h1 {
    font-size: 32px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 24px;
    letter-spacing: 0.3px;
  }

  p {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: 16px;
  }
  p.lede {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.88);
  }
  p.muted { color: rgba(255, 255, 255, 0.5); }

  p.email {
    margin-top: 24px;
    font-size: 17px;
    font-weight: 400;
    user-select: all;
  }
  p.email a {
    color: rgba(255, 255, 255, 0.95);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 1px;
    transition: border-color 0.18s ease, color 0.18s ease;
  }
  p.email a:hover {
    border-color: rgba(180, 160, 240, 0.7);
    color: hsla(265, 60%, 85%, 1);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }
  .link {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .link:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.36);
    transform: translateY(-1px);
  }
</style>
