---
import Base from '../../layouts/Base.astro';
import OrbStage from '../../components/OrbStage.astro';
import { stats } from './_privacy';

const rivals = [
  { href: '/compare/niyora-vs-flo/', name: 'Flo' },
  { href: '/compare/niyora-vs-clue/', name: 'Clue' },
  { href: '/compare/niyora-vs-stardust/', name: 'Stardust' },
  { href: '/compare/niyora-vs-bearable/', name: 'Bearable' },
  { href: '/compare/niyora-vs-apple-cycle-tracking/', name: 'Apple Cycle Tracking' },
  { href: '/compare/niyora-vs-cara-care/', name: 'Cara Care' },
  { href: '/compare/niyora-vs-moody-month/', name: 'Moody Month' },
  { href: '/compare/niyora-vs-ai-companion/', name: 'an AI companion' },
  { href: '/compare/moon-ai-vs-other-ai/', name: 'other AI' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Compare Niyora',
  description: 'How Niyora differs from cycle trackers and mood apps, and what each one does with your data.',
  url: 'https://niyora.com/compare/',
};
---

<Base
  title="Compare Niyora with other cycle and mood apps · Niyora"
  description={`Head to head with Flo, Clue, Stardust, Bearable and more. Plus what ${stats.total} cycle apps told Apple they do with your data, in their own words.`}
  canonicalUrl="https://niyora.com/compare/"
  jsonLd={jsonLd}
>
  <OrbStage />

  <main class="content">
    <section class="hero" data-hue="278" data-sat="55%">
      <div class="eyebrow">Compare</div>
      <h1>How Niyora is different, and what the others do with your data</h1>
      <p class="lede">
        Most cycle apps are trackers. They find the pattern and hand it back to you. Niyora tracks
        and predicts too, then walks you through the hard hour when it lands.
      </p>
    </section>

    <section class="feature-section" data-hue="248" data-sat="55%">
      <a class="feature" href="/compare/privacy/">
        <div class="feature-tag">The data table</div>
        <h2>What {stats.total} cycle apps say they do with your data</h2>
        <p>
          Not my opinion of them. What each one told Apple, and what each one wrote in its own
          privacy policy, side by side with a link to every source. {stats.tracked} of {stats.total}{' '}
          declare data that may track you across other companies' apps. One says deletion reaches
          data it already shared.
        </p>
        <span class="go">Read the table</span>
      </a>
    </section>

    <section class="rivals-section" data-hue="300" data-sat="52%">
      <h2>Head to head</h2>
      <p class="lede">The short version, app by app.</p>
      <div class="rival-grid">
        {rivals.map((r) => (
          <a class="rival" href={r.href}>
            <span class="vs">Niyora vs</span>
            <span class="name">{r.name}</span>
          </a>
        ))}
      </div>
      <div class="cta-row">
        <a href="/compare/alternatives-to-mood-trackers/" class="cta ghost">Alternatives to mood trackers</a>
      </div>
    </section>

    <section class="cta-section" data-hue="30" data-sat="70%">
      <h2>The honest pitch</h2>
      <p class="lede">
        Niyora has no account, keeps your writing encrypted on your phone, and shows you the
        evidence behind every claim it makes. Including the weak evidence.
      </p>
      <div class="cta-row">
        <a href="/quiz/" class="cta">Take the quiz</a>
        <a href="/research/" class="cta ghost">See the research</a>
      </div>
    </section>
  </main>

  <footer>
    <a href="/pms/">Symptoms</a>
    <a href="/research/">Research</a>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <div class="copyright">© 2026 Niyora. Built quietly in Norway.</div>
  </footer>
</Base>

<style>
  .content { position: relative; z-index: 2; }
  section {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 72px 40px; max-width: 1080px; margin: 26px auto; border-radius: 32px;
    background: rgba(12, 10, 20, 0.24); border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(1.15); -webkit-backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.34); text-align: center;
  }
  @media (max-width: 720px) { section { margin: 14px; border-radius: 24px; padding: 56px 20px; } }
  .hero { padding: 96px 40px 80px; }
  .eyebrow {
    font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
    color: hsla(var(--orb-hue), 50%, 75%, 0.7); margin-bottom: 16px; transition: color 1.4s ease;
  }
  h1 {
    font-size: 46px; font-weight: 400; line-height: 1.16; letter-spacing: -0.5px;
    margin-bottom: 22px; max-width: 820px; color: rgba(255, 255, 255, 0.96);
  }
  h2 { font-size: 30px; font-weight: 400; color: rgba(255, 255, 255, 0.94); margin-bottom: 14px; max-width: 720px; }
  p { font-size: 17px; font-weight: 300; color: rgba(255, 255, 255, 0.66); max-width: 660px; }
  p.lede { font-size: 20px; color: rgba(255, 255, 255, 0.74); line-height: 1.55; }

  .feature {
    display: block; width: 100%; max-width: 820px; padding: 38px 34px 32px; border-radius: 24px;
    border: 1px solid hsla(var(--orb-hue), 55%, 65%, 0.35); background: var(--glass-bg);
    box-shadow: var(--glass-shadow); text-decoration: none; text-align: left;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .feature:hover { transform: translateY(-3px); border-color: hsla(var(--orb-hue), 60%, 75%, 0.6); }
  .feature-tag {
    font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
    color: hsla(var(--orb-hue), 60%, 80%, 0.9); margin-bottom: 14px;
  }
  .feature p { max-width: none; font-size: 16px; line-height: 1.6; }
  .go {
    display: inline-block; margin-top: 18px; font-size: 12px; letter-spacing: 2px;
    text-transform: uppercase; color: rgba(255, 255, 255, 0.72);
  }

  .rival-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
    width: 100%; max-width: 900px; margin-top: 24px;
  }
  .rival {
    display: flex; flex-direction: column; gap: 4px; padding: 20px 22px; border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.13); background: var(--glass-bg-soft);
    text-decoration: none; text-align: left; transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .rival:hover { transform: translateY(-2px); border-color: rgba(255, 255, 255, 0.4); }
  .vs { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }
  .name { font-size: 17px; color: rgba(255, 255, 255, 0.92); }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 24px; }
  .cta {
    display: inline-block; padding: 16px 36px; border-radius: 32px; background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.4); color: rgba(18, 16, 32, 0.95); font-size: 16px;
    font-weight: 500; text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    box-shadow: 0 8px 32px hsla(var(--orb-hue), 60%, 55%, 0.35);
  }
  .cta:hover { transform: translateY(-2px) scale(1.02); color: hsla(var(--orb-hue), 70%, 32%, 1); }
  .cta.ghost {
    background: transparent; border-color: rgba(255, 255, 255, 0.22); box-shadow: none;
    color: rgba(255, 255, 255, 0.85); padding: 13px 26px; font-size: 15px;
  }
  .cta.ghost:hover { background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 1); }

  footer {
    text-align: center; padding: 60px 24px 80px; color: rgba(255, 255, 255, 0.3);
    font-size: 13px; position: relative; z-index: 2;
  }
  footer a { color: rgba(255, 255, 255, 0.45); text-decoration: none; margin: 0 14px; }
  footer .copyright { margin-top: 16px; font-size: 12px; color: rgba(255, 255, 255, 0.2); }

  @media (max-width: 900px) { .rival-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .rival-grid { grid-template-columns: 1fr; }
    h1 { font-size: 32px; } h2 { font-size: 25px; } p.lede { font-size: 17px; }
  }
</style>
