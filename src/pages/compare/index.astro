---
import Page from '../../layouts/Page.astro';
import { breadcrumbs } from '../../components/_breadcrumbs';
import { stats } from './_privacy';

const rivals = [
  { href: '/compare/niyora-vs-flo/', name: 'Flo' },
  { href: '/compare/niyora-vs-clue/', name: 'Clue' },
  { href: '/compare/niyora-vs-stardust/', name: 'Stardust' },
  { href: '/compare/niyora-vs-bearable/', name: 'Bearable' },
  { href: '/compare/niyora-vs-apple-cycle-tracking/', name: 'Apple Cycle Tracking' },
  { href: '/compare/niyora-vs-cara-care/', name: 'Cara Care' },
  { href: '/compare/niyora-vs-moody-month/', name: 'Moody Month' },
  { href: '/compare/niyora-vs-ai-companion/', name: 'an AI companion' },
  { href: '/compare/moon-ai-vs-other-ai/', name: 'other AI' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Compare Niyora',
  description: 'How Niyora differs from cycle trackers and mood apps, and what each one does with your data.',
  url: 'https://niyora.com/compare/',
};

const crumbs = breadcrumbs([{ name: 'Compare', href: '/compare/' }]);
---

<Page
  title="Compare Niyora with other cycle and mood apps · Niyora"
  description={`Head to head with Flo, Clue, Stardust, Bearable and more. Plus what ${stats.total} cycle apps told Apple they do with your data, in their own words.`}
  canonicalUrl="https://niyora.com/compare/"
  jsonLd={[jsonLd, crumbs]}
>
  <section class="s hero">
    <div class="eyebrow">Compare</div>
    <h1>How Niyora is different, and what the others do with your data</h1>
    <p class="lead">
      Most cycle apps are trackers. They find the pattern and hand it back to you. Niyora tracks
      and predicts too, then walks you through the hard hour when it lands.
    </p>
  </section>

  <section class="s">
    <a class="feature" href="/compare/privacy/">
      <div class="feature-tag">The data table</div>
      <h2>What {stats.total} cycle apps say they do with your data</h2>
      <p>
        Not my opinion of them. What each one told Apple, and what each one wrote in its own
        privacy policy, side by side with a link to every source. {stats.tracked} of {stats.total}{' '}
        declare data that may track you across other companies' apps. One says deletion reaches
        data it already shared.
      </p>
      <span class="go">Read the table</span>
    </a>
  </section>

  <section class="s">
    <h2>Head to head</h2>
    <p class="lead">The short version, app by app.</p>
    <div class="rival-grid">
      {rivals.map((r) => (
        <a class="rival" href={r.href}>
          <span class="vs">Niyora vs</span>
          <span class="name">{r.name}</span>
        </a>
      ))}
    </div>
    <div class="cta-row">
      <a href="/compare/alternatives-to-mood-trackers/" class="btn ghost">Alternatives to mood trackers</a>
    </div>
  </section>

  <section class="s">
    <h2>The honest pitch</h2>
    <p class="lead">
      Niyora has no account, keeps your writing encrypted on your phone, and shows you the
      evidence behind every claim it makes. Including the weak evidence.
    </p>
    <div class="cta-row">
      <a href="/quiz/" class="btn">Take the quiz</a>
      <a href="/research/" class="btn ghost">See the research</a>
    </div>
  </section>
</Page>

<style>
  /* Page-specific only: the featured data-table card and the rival grid.
     Shared chrome (sheet, sections, dividers, type scale, buttons, footer)
     comes from Page. */
  .feature {
    display: block;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 30px;
    border-radius: 20px;
    border: 1px solid rgba(var(--accent-rgb), 0.28);
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    text-align: left;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .feature:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb), 0.5); }
  .feature h2 { max-width: none; margin: 0 0 12px; text-align: left; }
  .feature p { font-size: 16px; line-height: 1.6; color: rgba(255, 255, 255, 0.78); }
  .feature-tag {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(var(--accent-rgb), 0.85);
    margin-bottom: 14px;
  }
  .go {
    display: inline-block;
    margin-top: 18px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .rival-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 900px;
    margin: 24px auto 0;
  }
  .rival {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 20px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    text-align: left;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .rival:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb), 0.4); }
  .vs { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255, 255, 255, 0.4); }
  .name { font-size: 17px; color: rgba(255, 255, 255, 0.92); }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 28px; }

  @media (max-width: 900px) { .rival-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .s { padding: 56px 24px; }
    .rival-grid { grid-template-columns: 1fr; }
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
  }
</style>
