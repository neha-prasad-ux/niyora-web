---
import Base from '../../layouts/Base.astro';
import OrbStage from '../../components/OrbStage.astro';

import { downloads } from '../../config/downloads';
const appStore = downloads.appStore;

const rows = [
  'Built for the hard premenstrual moment',
  'Helps you need it less, not more',
  'Your personal details are stripped before anything is sent',
  'Never used to train the AI',
  'Not read by humans',
  'No account, and your history stays encrypted on your phone',
];
---

<Base
  title="Moon AI vs other AI: built for the hard moment, and to know almost nothing about you · Niyora"
  description="Most AI is built to keep you talking and learns from what you type. Moon is built for one hard premenstrual moment, helps you through it, and is designed to know as little about you as possible."
  canonicalUrl="https://niyora.com/compare/moon-ai-vs-other-ai/"
>
  <OrbStage />

  <main class="content">
    <section class="hero" data-hue="278" data-sat="58%">
      <div class="eyebrow">Moon AI vs other AI</div>
      <h1>Moon is a different kind of AI.</h1>
      <p class="lede">Most AI is built to hold your attention and learns from everything you type. Moon is built for one thing, the hard premenstrual moment, and it is designed to know as little about you as possible.</p>
    </section>

    <section class="table-section" data-hue="300" data-sat="55%">
      <div class="compare-layout">
        <div class="compare-grid">
          <div class="compare-head"></div>
          <div class="compare-head us">Moon AI</div>
          <div class="compare-head them">Other AI</div>

          {rows.map((label) => (
            <>
              <div class="row-label"><p>{label}</p></div>
              <div class="mark yes" aria-label="Moon AI: yes">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div class="mark no" aria-label="Other AI: no">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
              </div>
            </>
          ))}
        </div>

        <div class="phone" aria-hidden="true">
          <div class="phone-screen"></div>
        </div>
      </div>
    </section>

    <section class="honest-section" data-hue="278" data-sat="55%">
      <div class="honest">
        <h2>The honest version</h2>
        <p>Moon is an AI, not a doctor, therapist, or friend. When Moon reflects your words, the scrubbed text is processed by Google's enterprise AI, which does not train on it and does not have humans read it. Your cycle history and what you write are stored encrypted on your device, not in an account.</p>
      </div>
    </section>

    <section class="cta-section" data-hue="30" data-sat="70%">
      <h2>See it in your own hard week.</h2>
      <div class="cta-row">
        <a href="/quiz" class="cta">Take the 2-minute check</a>
        <a href={appStore} class="cta ghost">Get Niyora</a>
      </div>
    </section>
  </main>

  <footer>
    <a href="/compare/alternatives-to-mood-trackers/">Alternatives to mood trackers</a>
    <a href="/compare/niyora-vs-ai-companion/">Niyora vs AI companion</a>
    <a href="/blog/">Writing</a>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <div class="copyright">© 2026 Niyora. Built quietly in Norway.</div>
  </footer>
</Base>

<style>
  .content { position: relative; z-index: 2; }

  section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 72px 40px;
    max-width: 1080px;
    margin: 26px auto;
    border-radius: 32px;
    background: rgba(12, 10, 20, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.34);
    text-align: center;
  }
  @media (max-width: 720px) {
    section { margin: 14px; border-radius: 24px; padding: 56px 20px; }
  }

  .hero { padding: 96px 40px 80px; }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: hsla(var(--orb-hue), 50%, 75%, 0.7);
    margin-bottom: 16px;
    transition: color 1.4s ease;
  }

  h1 {
    font-size: 48px;
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.5px;
    margin-bottom: 22px;
    max-width: 780px;
    color: rgba(255, 255, 255, 0.96);
  }
  h2 {
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.3px;
    margin-bottom: 20px;
    max-width: 720px;
    color: rgba(255, 255, 255, 0.94);
  }
  p { font-size: 17px; font-weight: 300; color: rgba(255, 255, 255, 0.66); max-width: 640px; }
  p.lede { font-size: 20px; color: rgba(255, 255, 255, 0.74); line-height: 1.55; }

  /* Table + phone layout */
  .compare-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 44px;
    align-items: center;
    width: 100%;
    max-width: 960px;
  }
  @media (max-width: 820px) {
    .compare-layout { grid-template-columns: 1fr; gap: 40px; justify-items: center; }
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 72px 72px;
    align-items: center;
    gap: 4px 8px;
    width: 100%;
    text-align: left;
  }
  .compare-head {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 0 10px;
    text-align: center;
  }
  .compare-head.us { color: hsla(var(--orb-hue), 60%, 80%, 0.95); transition: color 1.4s ease; }
  .compare-head.them { color: rgba(255, 255, 255, 0.4); }

  .row-label {
    padding: 16px 16px 16px 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }
  .row-label p { font-size: 15px; line-height: 1.45; margin: 0; max-width: none; color: rgba(255, 255, 255, 0.82); }

  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    align-self: stretch;
  }
  .mark.yes { color: hsla(310, 70%, 74%, 0.98); }
  .mark.no { color: rgba(255, 255, 255, 0.32); }

  @media (max-width: 480px) {
    .compare-grid { grid-template-columns: 1fr 52px 52px; }
    .row-label p { font-size: 14px; }
  }

  /* Phone frame */
  .phone {
    width: 230px;
    max-width: 62vw;
    aspect-ratio: 9 / 19.5;
    padding: 9px;
    border-radius: 44px;
    background: #14121b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 70px hsla(278, 60%, 40%, 0.4), 0 0 60px hsla(300, 60%, 55%, 0.22);
    flex-shrink: 0;
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 36px;
    background-color: #0a0814;
    background-image: url('/app/meet-moon.png');
    background-size: cover;
    background-position: center;
  }

  .honest { max-width: 680px; }
  .honest p { margin: 0 auto; color: rgba(255, 255, 255, 0.7); font-size: 18px; line-height: 1.6; }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 12px; }
  .cta {
    display: inline-block;
    padding: 16px 36px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: rgba(18, 16, 32, 0.95);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.3px;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    box-shadow: 0 8px 32px hsla(var(--orb-hue), 60%, 55%, 0.35), 0 0 64px hsla(var(--orb-hue), 60%, 60%, 0.2);
  }
  .cta:hover {
    transform: translateY(-2px) scale(1.02);
    background: rgba(255, 255, 255, 1);
    color: hsla(var(--orb-hue), 70%, 32%, 1);
    box-shadow: 0 0 0 2px hsla(var(--orb-hue), 80%, 70%, 0.45), 0 14px 48px hsla(var(--orb-hue), 80%, 60%, 0.75);
  }
  .cta.ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: none;
    color: rgba(255, 255, 255, 0.85);
  }
  .cta.ghost:hover { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.5); color: rgba(255, 255, 255, 1); }

  footer {
    text-align: center;
    padding: 60px 24px 80px;
    color: rgba(255, 255, 255, 0.3);
    font-size: 13px;
    position: relative;
    z-index: 2;
  }
  footer a { color: rgba(255, 255, 255, 0.45); text-decoration: none; margin: 0 14px; }
  footer a:hover { color: rgba(255, 255, 255, 0.8); }
  footer .copyright { margin-top: 16px; font-size: 12px; color: rgba(255, 255, 255, 0.2); }

  @media (max-width: 720px) {
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
    p.lede { font-size: 17px; }
  }
</style>
