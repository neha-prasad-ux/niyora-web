---
import Page from '../../layouts/Page.astro';
import { breadcrumbs } from '../../components/_breadcrumbs';
import { downloads } from '../../config/downloads';

const rows = [
  'Built for the hard premenstrual moment',
  'Helps you need it less, not more',
  'Your personal details are stripped before anything is sent',
  'Never used to train the AI',
  'Not read by humans',
  'No account, and your history stays encrypted on your phone',
];

const crumbs = breadcrumbs([{ name: 'Compare', href: '/compare/' }, { name: 'Moon AI vs other AI', href: '/compare/moon-ai-vs-other-ai/' }]);
---

<Page
  title="Moon AI vs other AI: for the moment, not for chat · Niyora"
  description="Most AI keeps you talking and learns from what you type. Moon is built for one premenstrual moment, and designed to know as little about you as it can."
  canonicalUrl="https://niyora.com/compare/moon-ai-vs-other-ai/"
  jsonLd={crumbs}
>
  <section class="s hero">
    <div class="eyebrow">Moon AI vs other AI</div>
    <h1>Moon is a different kind of AI.</h1>
    <p class="lead">Most AI is built to hold your attention and learns from everything you type. Moon is built for one thing, the hard premenstrual moment, and it is designed to know as little about you as possible.</p>
  </section>

  <section class="s">
    <div class="compare-layout">
      <div class="compare-grid">
        <div class="compare-head"></div>
        <div class="compare-head us">Moon AI</div>
        <div class="compare-head them">Other AI</div>

        {rows.map((label) => (
          <>
            <div class="row-label"><p>{label}</p></div>
            <div class="mark yes" aria-label="Moon AI: yes">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="mark no" aria-label="Other AI: no">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            </div>
          </>
        ))}
      </div>

      <div class="phone" aria-hidden="true">
        <div class="phone-screen"></div>
      </div>
    </div>
  </section>

  <section class="s">
    <div class="honest">
      <h2>The honest version</h2>
      <p>Moon is an AI, not a doctor, therapist, or friend. When Moon reflects your words, the scrubbed text is processed by Google's enterprise AI, which does not train on it and does not have humans read it. Your cycle history and what you write are stored encrypted on your device, not in an account.</p>
    </div>
  </section>

  <section class="s">
    <h2>See it in your own hard week.</h2>
    <div class="cta-row">
      <a href="/quiz" class="btn">Take the 2-minute check</a>
      <a href={downloads.appStore} class="btn ghost">Get Niyora</a>
    </div>
  </section>
</Page>

<style>
  /* Page-specific only: the check/cross table beside the phone, and the
     to-be-fair block. Shared chrome (sheet, sections, dividers, type scale,
     buttons, footer) comes from Page's global CSS. */
  .compare-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 44px;
    align-items: center;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }
  @media (max-width: 820px) {
    .compare-layout { grid-template-columns: 1fr; gap: 40px; justify-items: center; }
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr 72px 72px;
    align-items: center;
    gap: 4px 8px;
    width: 100%;
    text-align: left;
  }
  .compare-head {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 0 10px;
    text-align: center;
  }
  .compare-head.us { color: rgba(var(--accent-rgb), 0.95); }
  .compare-head.them { color: rgba(255, 255, 255, 0.4); }

  .row-label {
    padding: 16px 16px 16px 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }
  .row-label p { font-size: 15px; line-height: 1.45; margin: 0; max-width: none; color: rgba(255, 255, 255, 0.82); }

  .mark {
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    align-self: stretch;
  }
  .mark.yes { color: rgba(var(--accent-rgb), 0.98); }
  .mark.no { color: rgba(255, 255, 255, 0.32); }

  @media (max-width: 480px) {
    .compare-grid { grid-template-columns: 1fr 52px 52px; }
    .row-label p { font-size: 14px; }
  }

  .phone {
    width: 230px;
    max-width: 62vw;
    aspect-ratio: 9 / 19.5;
    padding: 9px;
    border-radius: 44px;
    background: #0b0912;
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(150, 120, 220, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    flex-shrink: 0;
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    border-radius: 36px;
    background-color: #0a0814;
    background-image: url('/app/meet-moon.png');
    background-size: cover;
    background-position: center;
  }

  .honest { max-width: 680px; margin: 0 auto; }
  .honest p { color: rgba(255, 255, 255, 0.72); font-size: 18px; line-height: 1.6; max-width: none; }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 28px; }

  @media (max-width: 720px) {
    .s { padding: 56px 24px; }
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
  }
</style>
