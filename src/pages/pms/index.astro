---
import Page from '../../layouts/Page.astro';
import { breadcrumbs } from '../../components/_breadcrumbs';

const symptoms = [
  { href: '/pms/anxiety/', name: 'Anxiety', line: 'Worry that arrives out of proportion to anything happening. A text, a silence, a small task starts to feel like a threat.' },
  { href: '/pms/anger/', name: 'Anger', line: 'Rage that arrives fast and lands on the people closest to you, then leaves you holding the guilt.' },
  { href: '/pms/crying/', name: 'Crying', line: 'Tears with no clear cause, or far more tears than the cause deserves.' },
  { href: '/pms/brain-fog/', name: 'Brain fog', line: 'Words go missing, focus slips, and work that is normally easy takes twice as long.' },
  { href: '/pms/insomnia/', name: 'Insomnia', line: 'Your body is tired and your mind will not stop going over things.' },
  { href: '/pms/overwhelm/', name: 'Overwhelm', line: 'Everything arrives at once and none of it feels manageable.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'PMS symptoms',
  description: 'What happens in the days before your period, symptom by symptom, and what helps in the moment.',
  url: 'https://niyora.com/pms/',
};

const crumbs = breadcrumbs([{ name: 'Symptoms', href: '/pms/' }]);
---

<Page
  title="PMS symptoms, one at a time · Niyora"
  description="PMS symptoms one at a time: anxiety, anger, crying, brain fog, insomnia, overwhelm. What is happening in your body, and what helps in the moment."
  canonicalUrl="https://niyora.com/pms/"
  jsonLd={[jsonLd, crumbs]}
>
  <section class="s hero">
    <div class="eyebrow">Symptoms</div>
    <h1>Start with what you are feeling</h1>
    <p class="lead">
      The days before your period do not hit everyone the same way. Pick the one that matches
      yours. Each page explains what is happening in your body, why it feels bigger than the
      situation, and what actually helps when it lands.
    </p>
  </section>

  <section class="s">
    <div class="sym-grid">
      {symptoms.map((s) => (
        <a class="sym" href={s.href}>
          <h2>{s.name}</h2>
          <p>{s.line}</p>
          <span class="go">Read this one</span>
        </a>
      ))}
    </div>
  </section>

  <section class="s">
    <h2>Not sure which one it is</h2>
    <p class="lead">
      The two-minute check asks how your premenstrual week actually lands, and points you at the
      right place to start.
    </p>
    <div class="cta-row">
      <a href="/quiz/" class="btn">Take the quiz</a>
      <a href="/research/" class="btn ghost">See the research behind it</a>
    </div>
  </section>
</Page>

<style>
  /* Page-specific only: the symptom card grid. Shared chrome (sheet, sections,
     dividers, type scale, buttons, footer) comes from Page. */
  .sym-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    text-align: left;
  }
  .sym {
    display: flex;
    flex-direction: column;
    padding: 26px 24px 22px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    text-decoration: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .sym:hover { transform: translateY(-2px); border-color: rgba(var(--accent-rgb), 0.4); }
  .sym h2 { font-size: 22px; margin: 0 0 10px; letter-spacing: -0.2px; }
  .sym p { font-size: 15px; line-height: 1.55; flex: 1; }
  .go {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(var(--accent-rgb), 0.85);
    margin-top: 16px;
  }

  .cta-row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 28px; }

  @media (max-width: 900px) { .sym-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .s { padding: 56px 24px; }
    .sym-grid { grid-template-columns: 1fr; }
    h1 { font-size: 34px; }
    h2 { font-size: 26px; }
  }
</style>
