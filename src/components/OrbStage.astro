---
---

<canvas class="sky" aria-hidden="true"></canvas>
<div class="nebula neb-tl" aria-hidden="true"></div>
<div class="nebula neb-br" aria-hidden="true"></div>

<div class="orb-stage" aria-hidden="true">
  <div class="moon-field">
    <div class="halo"></div>
    <div class="moon"></div>
    <span class="mote m1"></span>
    <span class="mote m2"></span>
    <span class="mote m3"></span>
    <span class="mote m4"></span>
    <span class="mote m5"></span>
  </div>
</div>

<script>
  const root = document.documentElement;

  // Sections still set --orb-hue for small copy accents; the moon stays fixed.
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-hue]'));
  const observer = new IntersectionObserver(
    (entries) => {
      let best: IntersectionObserverEntry | null = null;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (!best || e.intersectionRatio > best.intersectionRatio) best = e;
      }
      if (best) {
        const t = best.target as HTMLElement;
        root.style.setProperty('--orb-hue', t.dataset.hue ?? '30');
        root.style.setProperty('--orb-sat', t.dataset.sat ?? '70%');
        root.style.setProperty('--orb-alpha', t.dataset.orbAlpha ?? '0.55');
        root.style.setProperty('--orb-scale', t.dataset.orbScale ?? '1');
      }
    },
    { threshold: [0.3, 0.6, 0.9] }
  );
  sections.forEach((s) => observer.observe(s));

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          root.style.setProperty('--orb-y', `${window.scrollY * 0.05}px`);
          ticking = false;
        });
      },
      { passive: true }
    );
  }

  // Starfield + occasional shooting star, on one canvas.
  const canvas = document.querySelector<HTMLCanvasElement>('.sky');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    let W = 0, H = 0, DPR = 1;
    let stars: { x: number; y: number; r: number; a: number; tw: number; ts: number }[] = [];

    const resize = () => {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.width = Math.floor(window.innerWidth * DPR);
      H = canvas.height = Math.floor(window.innerHeight * DPR);
      canvas.style.width = window.innerWidth + 'px';
      canvas.style.height = window.innerHeight + 'px';
      const count = Math.min(260, Math.round((window.innerWidth * window.innerHeight) / 9000));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: (Math.random() * 1.1 + 0.3) * DPR,
        a: Math.random() * 0.5 + 0.28,
        tw: Math.random() * Math.PI * 2,
        ts: 0.5 + Math.random() * 1.1,
      }));
    };

    // Shooting star: matches the app cadence (first ~2s, then ~4s, then 7-16s),
    // alternating direction, ~0.85s arc 28-58 degrees below horizontal.
    let shoot: { x: number; y: number; vx: number; vy: number; t: number; len: number } | null = null;
    const fire = (dir: number) => {
      const startX = dir < 0 ? W * (0.55 + Math.random() * 0.4) : W * (0.05 + Math.random() * 0.4);
      const startY = H * (0.06 + Math.random() * 0.24);
      const down = ((28 + Math.random() * 30) * Math.PI) / 180;
      const dist = Math.hypot(W, H) * (0.3 + Math.random() * 0.22);
      shoot = { x: startX, y: startY, vx: Math.cos(down) * dist * dir, vy: Math.sin(down) * dist, t: 0, len: 130 * DPR };
    };
    let n = 0;
    const schedule = () => {
      const delay = n === 0 ? 2000 : n === 1 ? 4000 : 7000 + Math.random() * 9000;
      window.setTimeout(() => {
        if (!reduce) { fire(n % 2 === 0 ? -1 : 1); n += 1; }
        schedule();
      }, delay);
    };

    let last = performance.now();
    const frame = (now: number) => {
      const dt = now - last; last = now;
      ctx.clearRect(0, 0, W, H);
      for (const s of stars) {
        let alpha = s.a;
        if (!reduce) { s.tw += (s.ts * dt) / 1000; alpha = s.a * (0.6 + 0.4 * Math.sin(s.tw)); }
        ctx.globalAlpha = alpha;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = '#dfe7ff';
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (shoot) {
        shoot.t += dt;
        const dur = 850;
        const p = Math.min(shoot.t / dur, 1);
        const ease = p * p;
        const hx = shoot.x + shoot.vx * ease, hy = shoot.y + shoot.vy * ease;
        const mag = Math.hypot(shoot.vx, shoot.vy) || 1;
        const tailX = hx - (shoot.vx / mag) * shoot.len, tailY = hy - (shoot.vy / mag) * shoot.len;
        const grad = ctx.createLinearGradient(tailX, tailY, hx, hy);
        grad.addColorStop(0, 'rgba(255,255,255,0)');
        grad.addColorStop(1, 'rgba(255,255,255,0.95)');
        const op = p < 0.14 ? p / 0.14 : Math.max(0, 1 - (p - 0.5) / 0.5);
        ctx.globalAlpha = Math.max(0, op) * 0.95;
        ctx.strokeStyle = grad as unknown as string;
        ctx.lineWidth = 2 * DPR;
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(tailX, tailY);
        ctx.lineTo(hx, hy);
        ctx.stroke();
        ctx.globalAlpha = 1;
        if (p >= 1) shoot = null;
      }
      requestAnimationFrame(frame);
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    requestAnimationFrame(frame);
    schedule();
  }
</script>

<style>
  .sky {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
  .nebula {
    position: fixed;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(60px);
  }
  .neb-tl {
    top: -18%;
    left: -14%;
    width: 58vw;
    height: 58vw;
    background: radial-gradient(circle, rgba(110, 143, 214, 0.18) 0%, rgba(110, 143, 214, 0) 66%);
  }
  .neb-br {
    bottom: -18%;
    right: -14%;
    width: 58vw;
    height: 58vw;
    background: radial-gradient(circle, rgba(176, 116, 192, 0.18) 0%, rgba(176, 116, 192, 0) 66%);
  }

  .orb-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: skyIn 1.3s ease both;
  }
  .moon-field {
    position: relative;
    width: 340px;
    height: 340px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: var(--orb-alpha, 0.55);
    transform: translate3d(0, var(--orb-y, 0), 0) scale(var(--orb-scale, 1));
    transition: opacity 1.4s ease, transform 1.4s ease;
  }

  /* Crisp calm mint-white sphere: highlight top-left, depth bottom-right, body. */
  .moon {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 26%, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.2) 14%, transparent 42%),
      radial-gradient(circle at 76% 82%, hsla(178, 44%, 30%, 0.62) 0%, hsla(178, 38%, 40%, 0.28) 40%, transparent 72%),
      radial-gradient(circle at 38% 32%, #ffffff 0%, hsl(166, 24%, 93%) 40%, hsl(172, 27%, 84%) 88%, hsl(174, 28%, 79%) 100%);
    box-shadow: 0 24px 55px rgba(0, 0, 0, 0.45);
    animation: moonBreathe 4.2s ease-in-out infinite;
  }
  .halo {
    position: absolute;
    width: 540px;
    height: 540px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(217, 146, 176, 0) 44%,
      rgba(217, 146, 176, 0.9) 53%,
      rgba(156, 92, 134, 0.55) 66%,
      rgba(87, 48, 114, 0.32) 80%,
      rgba(58, 31, 92, 0) 100%
    );
    filter: blur(8px);
    animation: haloBreathe 4.2s ease-in-out infinite;
  }

  .mote {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(214, 226, 255, 0.7) 0%, rgba(214, 226, 255, 0) 70%);
  }
  .m1 { width: 10px; height: 10px; left: 16%; top: 30%; animation: drift 15s ease-in-out infinite; }
  .m2 { width: 7px;  height: 7px;  left: 82%; top: 40%; animation: drift 19s ease-in-out infinite 2s; }
  .m3 { width: 12px; height: 12px; left: 74%; top: 76%; animation: drift 22s ease-in-out infinite 1s; }
  .m4 { width: 6px;  height: 6px;  left: 24%; top: 72%; animation: drift 17s ease-in-out infinite 4s; }
  .m5 { width: 8px;  height: 8px;  left: 50%; top: 12%; animation: drift 24s ease-in-out infinite 3s; }

  @keyframes skyIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes moonBreathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.045); }
  }
  @keyframes haloBreathe {
    0%, 100% { transform: scale(1); opacity: 0.72; }
    50% { transform: scale(1.06); opacity: 1; }
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0); opacity: 0.15; }
    50% { transform: translate(18px, -26px); opacity: 0.55; }
  }

  @media (max-width: 720px) {
    .moon-field { width: 260px; height: 260px; }
    .moon { width: 220px; height: 220px; }
    .halo { width: 400px; height: 400px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orb-stage { animation: none; }
    .moon, .halo, .mote { animation: none; }
  }
</style>
