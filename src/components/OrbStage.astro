---

<div class="orb-stage" aria-hidden="true">
  <div class="orb-rings r2"></div>
  <div class="orb-rings"></div>
  <div class="orb"></div>
</div>
<div class="vignette" aria-hidden="true"></div>

<script>
  // Tier colours live in section data-attributes here.
  // If neha-prasad-ux/niyora src/tiers.ts adds HSL values, update both atomically.
  const root = document.documentElement;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-hue]'));

  const setOrb = (hue: string, sat: string, alpha: string, scale: string) => {
    root.style.setProperty('--orb-hue', hue);
    root.style.setProperty('--orb-sat', sat);
    root.style.setProperty('--orb-alpha', alpha);
    root.style.setProperty('--orb-scale', scale);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      let best: IntersectionObserverEntry | null = null;
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        if (!best || e.intersectionRatio > best.intersectionRatio) best = e;
      }
      if (best) {
        const t = best.target as HTMLElement;
        setOrb(
          t.dataset.hue ?? '30',
          t.dataset.sat ?? '70%',
          t.dataset.orbAlpha ?? '1',
          t.dataset.orbScale ?? '1'
        );
      }
    },
    { threshold: [0.3, 0.6, 0.9] }
  );
  sections.forEach((s) => observer.observe(s));

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY * 0.08;
          root.style.setProperty('--orb-y', `${y}px`);
          ticking = false;
        });
      },
      { passive: true }
    );
  }
</script>

<style>
  .orb-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .orb {
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      hsla(var(--orb-hue), var(--orb-sat), 80%, 0.95) 0%,
      hsla(var(--orb-hue), var(--orb-sat), var(--orb-light), 0.7) 45%,
      hsla(var(--orb-hue), 60%, 25%, 0.4) 100%
    );
    box-shadow:
      0 0 80px 20px hsla(var(--orb-hue), var(--orb-sat), 50%, 0.35),
      0 0 200px 40px hsla(var(--orb-hue), var(--orb-sat), 50%, 0.18);
    opacity: var(--orb-alpha, 1);
    transition: background 1.4s ease, box-shadow 1.4s ease, opacity 1.4s ease, transform 1.4s ease;
    transform: translate3d(0, var(--orb-y, 0), 0) scale(var(--orb-scale, 1));
  }
  .orb-rings {
    position: absolute;
    width: 720px;
    height: 720px;
    border-radius: 50%;
    border: 1px solid hsla(var(--orb-hue), 60%, 70%, 0.15);
    opacity: var(--orb-alpha, 1);
    transform: scale(var(--orb-scale, 1));
    transition: border-color 1.4s ease, opacity 1.4s ease, transform 1.4s ease;
  }
  .orb-rings.r2 {
    width: 920px;
    height: 920px;
    border-color: hsla(var(--orb-hue), 60%, 70%, 0.08);
  }
  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(ellipse at 50% 50%, transparent 30%, rgba(7, 6, 15, 0.7) 75%, rgba(7, 6, 15, 0.95) 100%);
  }
  @media (max-width: 720px) {
    .orb { width: 360px; height: 360px; }
    .orb-rings { width: 480px; height: 480px; }
    .orb-rings.r2 { width: 600px; height: 600px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orb { transition: none; }
  }
</style>
