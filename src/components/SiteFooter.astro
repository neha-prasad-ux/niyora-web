---
import { GROUPS } from './_nav';

const year = new Date().getFullYear();

/** Legal and contact sit apart from the content columns. */
const meta = [
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/changelog/', label: "What's new" },
];
---

<footer class="site-footer">
  <div class="foot-inner">
    <div class="foot-brand">
      <a href="/" class="foot-mark">Niyora</a>
      <p>
        A private iPhone app for the days before your period. Reflect on a hard moment, regulate in
        about a minute, respond with a clearer head.
      </p>
      <a href="/#interest" class="foot-cta">I'm interested</a>
    </div>

    <nav class="foot-cols" aria-label="Footer">
      {GROUPS.map((g) => (
        <div class="foot-col">
          <a class="foot-title" href={g.href}>{g.label}</a>
          {g.links.filter((l) => l.href !== g.href).map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      ))}
    </nav>
  </div>

  <div class="foot-base">
    <div class="foot-meta">
      {meta.map((m) => <a href={m.href}>{m.label}</a>)}
      <a href="mailto:neha@niyora.com">Contact</a>
    </div>
    <p class="foot-copy">© {year} Niyora. Built quietly in Norway.</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    max-width: 1160px;
    margin: 60px auto 0;
    padding: 0 clamp(20px, 4vw, 40px) 60px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .foot-inner {
    display: grid;
    grid-template-columns: minmax(220px, 300px) 1fr;
    gap: 48px;
    padding: 52px 0 40px;
  }

  .foot-mark {
    display: inline-block;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    margin-bottom: 14px;
  }
  .foot-brand p {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 18px;
    max-width: 300px;
  }
  .foot-cta {
    display: inline-block;
    padding: 9px 20px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    text-decoration: none;
    transition: border-color 0.3s ease, background 0.3s ease;
  }
  .foot-cta:hover { border-color: rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.09); }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 22px;
  }
  .foot-col { display: flex; flex-direction: column; gap: 2px; }
  .foot-col a {
    font-size: 13.5px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    padding: 4px 0;
    transition: color 0.25s ease;
  }
  .foot-col a:hover { color: rgba(255, 255, 255, 0.95); }
  .foot-title {
    font-size: 11px !important;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82) !important;
    margin-bottom: 8px;
  }

  .foot-base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .foot-meta { display: flex; gap: 22px; flex-wrap: wrap; }
  .foot-meta a {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.42);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .foot-meta a:hover { color: rgba(255, 255, 255, 0.85); }
  .foot-copy { font-size: 12px; color: rgba(255, 255, 255, 0.25); margin: 0; }

  @media (max-width: 1000px) {
    .foot-inner { grid-template-columns: 1fr; gap: 36px; }
    .foot-cols { grid-template-columns: repeat(3, 1fr); gap: 28px 22px; }
  }
  @media (max-width: 640px) {
    .foot-cols { grid-template-columns: repeat(2, 1fr); }
    .foot-base { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
