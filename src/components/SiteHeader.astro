---
import { GROUPS, META } from './_nav';
import { downloads } from '../config/downloads';
---

<header class="site-header">
  <a href="/" class="site-brand" aria-label="Niyora home">Niyora</a>

  <nav class="site-nav" aria-label="Main">
    {GROUPS.map((g) => (
      <div class="nav-group" data-group={g.label}>
        <button class="nav-trigger" aria-expanded="false" aria-haspopup="true">
          {g.label}<span class="chev" aria-hidden="true"></span>
        </button>
        <div class="nav-menu" hidden>
          {g.links.map((l) => <a href={l.href}>{l.label}</a>)}
        </div>
      </div>
    ))}
    <a href={downloads.appStore} class="site-nav-cta">Get the app</a>
  </nav>

  <button class="nav-burger" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>

  <div class="nav-drawer" id="nav-drawer" hidden>
    {GROUPS.map((g) => (
      <div class="drawer-group">
        <a class="drawer-title" href={g.href}>{g.label}</a>
        {g.links.filter((l) => l.href !== g.href).map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    ))}
    <div class="drawer-group drawer-meta">
      {META.map((m) => <a href={m.href}>{m.label}</a>)}
      <a href={downloads.appStore} class="drawer-cta">Get the app</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const groups = [...header.querySelectorAll<HTMLElement>('.nav-group')];

    const closeAll = (except?: HTMLElement) => {
      for (const g of groups) {
        if (g === except) continue;
        g.querySelector<HTMLElement>('.nav-menu')!.hidden = true;
        g.querySelector<HTMLButtonElement>('.nav-trigger')!.setAttribute('aria-expanded', 'false');
      }
    };

    for (const group of groups) {
      const trigger = group.querySelector<HTMLButtonElement>('.nav-trigger')!;
      const menu = group.querySelector<HTMLElement>('.nav-menu')!;
      const set = (open: boolean) => {
        menu.hidden = !open;
        trigger.setAttribute('aria-expanded', String(open));
        if (open) closeAll(group);
      };

      trigger.addEventListener('click', () => set(menu.hidden));
      group.addEventListener('mouseenter', () => set(true));
      group.addEventListener('mouseleave', () => set(false));
      group.addEventListener('focusout', (e) => {
        if (!group.contains(e.relatedTarget as Node)) set(false);
      });
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          set(true);
          menu.querySelector<HTMLAnchorElement>('a')?.focus();
        }
      });
    }

    const burger = header.querySelector<HTMLButtonElement>('.nav-burger')!;
    const drawer = header.querySelector<HTMLElement>('#nav-drawer')!;
    const setDrawer = (open: boolean) => {
      drawer.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      burger.classList.toggle('on', open);
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    burger.addEventListener('click', () => setDrawer(drawer.hidden));

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closeAll();
      if (!drawer.hidden) { setDrawer(false); burger.focus(); }
    });
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) { closeAll(); setDrawer(false); }
    });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px clamp(20px, 4vw, 40px);
    background: rgba(7, 6, 15, 0.6);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-brand {
    font-size: 15px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9); text-decoration: none;
  }

  .site-nav { display: flex; align-items: center; gap: 22px; }
  .site-nav a, .nav-trigger {
    font-family: inherit; font-size: 14px; letter-spacing: 0.3px;
    color: rgba(255, 255, 255, 0.6); text-decoration: none;
    background: none; border: none; padding: 0; cursor: pointer;
    transition: color 0.3s ease;
  }
  .site-nav a:hover, .nav-trigger:hover, .nav-trigger[aria-expanded='true'] {
    color: rgba(255, 255, 255, 0.95);
  }

  .nav-group { position: relative; }
  .nav-trigger { display: inline-flex; align-items: center; gap: 5px; padding: 6px 0; }
  .chev {
    width: 5px; height: 5px; border-right: 1.4px solid currentColor; border-bottom: 1.4px solid currentColor;
    transform: rotate(45deg) translateY(-1px); transition: transform 0.25s ease; opacity: 0.7;
  }
  .nav-trigger[aria-expanded='true'] .chev { transform: rotate(-135deg) translateY(-1px); }

  /* The hidden attribute is UA display:none, which the display:flex below
     would beat, leaving every menu permanently open. Same guard the drawer has. */
  .nav-menu[hidden] { display: none; }
  .nav-menu {
    position: absolute; top: calc(100% + 12px); left: -16px; min-width: 244px;
    display: flex; flex-direction: column; padding: 8px;
    background: rgba(16, 13, 25, 0.97);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
  }
  .nav-menu::before { content: ''; position: absolute; top: -12px; left: 0; right: 0; height: 12px; }
  .nav-menu a { padding: 9px 12px; border-radius: 9px; white-space: nowrap; }
  .nav-menu a:hover { background: rgba(255, 255, 255, 0.07); }

  .site-nav-cta {
    padding: 8px 18px; border-radius: 22px; border: 1px solid rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.92) !important; background: rgba(255, 255, 255, 0.04);
  }
  .site-nav-cta:hover { border-color: rgba(255, 255, 255, 0.5); background: rgba(255, 255, 255, 0.09); }

  .nav-burger { display: none; flex-direction: column; gap: 4.5px; background: none; border: none; padding: 6px; cursor: pointer; }
  .nav-burger span {
    display: block; width: 21px; height: 1.5px; background: rgba(255, 255, 255, 0.8);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-burger.on span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-burger.on span:nth-child(2) { opacity: 0; }
  .nav-burger.on span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .nav-drawer { display: none; }

  /* Five items plus a CTA stop fitting well before the phone breakpoint, so the
     whole nav becomes one drawer rather than wrapping into a second row. */
  @media (max-width: 900px) {
    .site-nav { display: none; }
    .nav-burger { display: flex; }
    .nav-drawer[hidden] { display: none; }
    .nav-drawer {
      display: block; position: absolute; top: 100%; right: 0;
      width: min(340px, 100vw); max-height: calc(100vh - 60px); overflow-y: auto;
      padding: 22px 24px 28px;
      background: rgba(14, 11, 22, 0.98);
      backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .drawer-group { margin-bottom: 20px; }
    .drawer-group:last-child { margin-bottom: 0; }
    .drawer-group a {
      display: block; padding: 7px 0; font-size: 15px;
      color: rgba(255, 255, 255, 0.68); text-decoration: none;
    }
    .drawer-title {
      font-size: 10px !important; letter-spacing: 2.5px; text-transform: uppercase;
      color: rgba(255, 255, 255, 0.38) !important; margin-bottom: 4px;
    }
    .drawer-cta {
      margin-top: 12px; padding: 10px 18px !important; border-radius: 22px;
      border: 1px solid rgba(255, 255, 255, 0.25); text-align: center;
      color: rgba(255, 255, 255, 0.95) !important;
    }
  }
  @media (max-width: 520px) { .site-brand { font-size: 14px; letter-spacing: 2px; } }
</style>
